---
import BaseLayout from "../layouts/baseLayout.astro";

import "../css/main.css";
import "../css/home.css";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Tvisha Patel — Product Designer</title>
		<link rel="icon" type="image/webp" href="/portfolio-favicon.webp" />
	</head>

	<body>
		<div class="page">
			<BaseLayout title="Home — Tvisha Patel" currentPage="home">
				<section class="hero wrap">
					<h1 class="hero-title">Hey, I’m Tvisha</h1>
					<p class="hero-tagline">
						A product designer building purposeful and productive
						experiences
						<span class="sparkles">✧✶</span>
					</p>
					<p class="hero-role">
						<span>Currently leading design at</span>
						<a
							href="https://strawberry.me"
							target="_blank"
							rel="noopener noreferrer"
						>
							Strawberry.me
							<span class="icon" aria-hidden="true">
								<img src="/icons/arrow-up-right.svg" alt="" />
							</span>
						</a>
						<span class="arr-note">($20M+ ARR)</span>
					</p>
					<a
						class="scroll-cue"
						href="#work"
						aria-label="Scroll to work"
					>
						<img src="/icons/chevron.svg" alt="" />
					</a>
				</section>

				<section class="stats wrap">
					<div class="stat-impact">
						<p class="impact-label">Impact highlights</p>
					</div>
					<div class="stat-item">
						<p class="stat-value">$20M+ ARR</p>
						<p class="stat-label">Supported Total Revenue</p>
					</div>
					<div class="stat-item">
						<p class="stat-value">5M+</p>
						<p class="stat-label">Users reached</p>
					</div>
					<div class="stat-item">
						<p class="stat-value">3+</p>
						<p class="stat-label">Design systems built</p>
					</div>
				</section>

				<section class="work-list wrap" id="work">
					<a class="work-card" href="">
						<div class="work-card-copy">
							<p class="eyebrow">
								Strawberry.me | Founding Product Designer •
								2024-present
							</p>
							<h2>
								0→1 design for AI-assisted coaching platform |
								$20M+ ARR
							</h2>
							<p>
								Designing an AI-message draft workflow for
								coaches that increased coach activation by X%
								and client retention by 15%
							</p>
						</div>
						<div
							class="placeholder"
							role="img"
							aria-label="Strawberry.me case study image placeholder"
						>
						</div>
					</a>

					<a class="work-card" href="">
						<div class="work-card-copy">
							<p class="eyebrow">Betterhelp | 2023</p>
							<h2>
								Simplifying technical complexity for clients and
								therapists
							</h2>
							<p>
								Designed a 33% more streamlined user flow by
								cutting unnecessary steps and friction,
								increasing call efficiency by minimizing session
								time lost to technical issues
							</p>
						</div>
						<div
							class="placeholder"
							role="img"
							aria-label="BetterHelp calls case study image placeholder"
						>
						</div>
					</a>

					<a class="work-card" href="/case-studies/echokids">
						<div class="work-card-copy">
							<p class="eyebrow">EchoKids | 2022</p>
							<h2>
								How I increased retention by 200% with a 47%
								more effective dashboard
							</h2>
							<p>
								Redesigned the mentor dashboard to look more
								modern, have intuitive workflows, and be
								consistent with the rest of the platform.
							</p>
						</div>
						<div
							class="placeholder"
							role="img"
							aria-label="EchoKids case study image placeholder"
						>
						</div>
					</a>
				</section>
			</BaseLayout>
		</div>
		<div class="copy-toast" role="status">Email copied</div>
	</body>
</html>
