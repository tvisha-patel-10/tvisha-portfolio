---
import BaseLayout from "../layouts/baseLayout.astro";

import "../css/main.css";
import "../css/home.css";
---

<BaseLayout
	title="Tvisha Patel — Founding Product Designer"
	description="I'm a founding product designer crafting 0→1 workflows, AI-assisted tools, and dual-sided marketplaces ($30M+ ARR)."
	currentPage="home"
>
	<section class="hero wrap">
		<h1 class="hero-title">Hey, I’m Tvisha</h1>
		<p class="hero-tagline">
			A product designer building things people actually want to use, from
			first idea to final screen
			<span class="sparkles"> ✧✶</span>
		</p>
		<p class="hero-role">
			<span>Currently leading design at</span>
			<a
				href="https://strawberry.me"
				target="_blank"
				rel="noopener noreferrer"
			>
				Strawberry.me
				<span class="icon" aria-hidden="true">
					<img src="/icons/arrow-up-right.svg" alt="" />
				</span>
			</a>
			<span class="arr-note">($30M+ ARR)</span>
		</p>
	</section>

	<!-- <section class="stats wrap">
					<div class="stat-impact">
						<p class="impact-label">Impact highlights</p>
					</div>
					<div class="stat-item">
						<p class="stat-value">$30+ ARR</p>
						<p class="stat-label">Supported Revenue</p>
					</div>
					<div class="stat-item">
						<p class="stat-value">5M+</p>
						<p class="stat-label">Users reached</p>
					</div>
					<div class="stat-item">
						<p class="stat-value">3+</p>
						<p class="stat-label">Design systems</p>
					</div>
				</section> -->

	<section class="work-list wrap" id="work">
		<a class="work-card" href="/case-studies/strawberry">
			<div
				class="placeholder"
				role="img"
				aria-label="Strawberry.me 0-1 case study video cover"
			>
				<video
					autoplay
					loop
					muted
					playsinline
					poster="/images/strawberry/Screenshot_2026-02-27_at_10.13.59_PM.png"
				>
					<source
						src="/images/strawberry/strawberry%200-1.mp4"
						type="video/mp4"
					/>
				</video>
			</div>
			<div class="work-card-copy">
				<p>
					0→1 work as founding product designer for a dual-sided
					coaching platform | $30M+ ARR
				</p>
				<p class="eyebrow">Strawberry.me | 2024-present</p>
			</div>
		</a>

		<a class="work-card" href="/case-studies/strawberry-ai">
			<div
				class="placeholder"
				role="img"
				aria-label="Strawberry.me case study image placeholder"
			>
				<video autoplay loop muted playsinline>
					<source
						src="/images/strawberry-ai/strawberryai_cover.mp4"
						type="video/mp4"
					/>
				</video>
			</div>
			<div class="work-card-copy">
				<p>AI message draft workflow for coaches</p>
				<p class="eyebrow">
					Strawberry.me | 2025
					<span class="work-card-lock" title="Password protected"
						>🔒 Protected</span
					>
				</p>
			</div>
		</a>

		<a class="work-card" href="/case-studies/betterhelp">
			<div
				class="placeholder placeholder-inset"
				role="img"
				aria-label="BetterHelp calls case study image placeholder"
			>
				<div class="inset-frame">
					<video
						autoplay
						loop
						muted
						playsinline
						poster="/images/betterhelp/Video_Session_Test_Landing_Page_final 3.png"
					>
						<source
							src="/images/betterhelp/betterhelp_cover.mp4"
							type="video/mp4"
						/>
					</video>
				</div>
			</div>
			<div class="work-card-copy">
				<p>
					Simplifying technical complexity for clients and therapists
				</p>
				<p class="eyebrow">BetterHelp | 2023</p>
			</div>
		</a>

		<a class="work-card" href="/case-studies/echokids">
			<div
				class="placeholder"
				role="img"
				aria-label="EchoKids case study video thumbnail"
			>
				<video
					autoplay
					loop
					muted
					playsinline
					poster="/images/echokids/Dashboard.png"
				>
					<source
						src="/images/echokids/echokids_cover.mp4"
						type="video/mp4"
					/>
				</video>
			</div>
			<div class="work-card-copy">
				<p>
					How I increased retention by 200% and created a 47% more
					effective dashboard
				</p>
				<p class="eyebrow">EchoKids | 2022</p>
			</div>
		</a>
	</section>
</BaseLayout>
