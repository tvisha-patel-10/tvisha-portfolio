                            <div class="wild-card-inner">
                                <div class="wild-card-front">
                                    <img
                                        src="/images/about/minecraft_pig.webp"
                                        alt="Minecraft pig build"
                                    />
                                    <span class="flip-hint" aria-hidden="true"
                                        >flip ↺</span
                                    >
                                </div>
                                <div class="wild-card-back">
                                    <div
                                        class="wild-card-tape"
                                        aria-hidden="true"
                                    >
                                    </div>
                                    <h3 class="wild-card-title">Minecraft</h3>
                                    <p class="wild-card-blurb">
                                        Where my spatial design and pixel art
                                        dreams run wild. I could spend hours
                                        building in this game (sorry to this pig
                                        for traumatizing it with cooked
                                        porkchop).
                                    </p>
                                    <span class="wild-card-tag"
                                        >📍 The Overworld</span
