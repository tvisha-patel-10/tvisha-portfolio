                            class="wild-card placeholder wild-tall"
                            role="button"
                            tabindex="0"
                            aria-label="Sequoia National Park - Click to flip"
                        >
                            <div class="wild-card-inner">
                                <div class="wild-card-front">
                                    <img
                                        src="/images/about/sequoia.webp"
                                        alt="Walking among giant trees in Sequoia"
                                    />
                                    <span class="flip-hint" aria-hidden="true"
                                        >flip ↺</span
                                    >
                                </div>
                                <div class="wild-card-back">
                                    <div
                                        class="wild-card-tape"
                                        aria-hidden="true"
                                    >
                                    </div>
                                    <h3 class="wild-card-title">
                                        Touching Grass
