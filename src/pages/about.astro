                                    <span class="flip-hint" aria-hidden="true"
                                        >flip ↺</span
                                    >
                                </div>
                                <div class="wild-card-back">
                                    <div
                                        class="wild-card-tape"
                                        aria-hidden="true"
                                    >
                                    </div>
                                    <h3 class="wild-card-title">
                                        Chasing Golden Hour
                                    </h3>
                                    <p class="wild-card-blurb">
                                        I’ll stop whatever I’m doing if the
                                        evening colors look like this.
                                    </p>
                                    <span class="wild-card-tag"
                                        >📍 Santa Barbara, CA</span
                                    >
                                </div>
                            </div>
                        </div>

                        <!-- Card 5 -->
                        <div
                            class="wild-card placeholder"
                            role="button"
                            tabindex="0"
                            aria-label="New York foodie adventures - Click to flip"
                        >
                            <div class="wild-card-inner">
                                <div class="wild-card-front">
                                    <img
                                        src="/images/about/ny_food.webp"
                                        alt="Good eats in NY"
                                    />
                                    <span class="flip-hint" aria-hidden="true"
                                        >flip ↺</span
                                    >
                                </div>
                                <div class="wild-card-back">
                                    <div
                                        class="wild-card-tape"
                                        aria-hidden="true"
                                    >
                                    </div>
                                    <h3 class="wild-card-title">
                                        Foodie Diary
                                    </h3>
                                    <p class="wild-card-blurb">
                                        My camera roll is roughly 70% food. I'm
                                        a firm believer in the camera eats first
                                        philosophy.
                                    </p>
                                    <span class="wild-card-tag"
                                        >📍 Koreatown, NYC, NY</span
                                    >
                                </div>
                            </div>
                        </div>

                        <!-- Card 6 -->
                        <div
                            class="wild-card placeholder"
                            role="button"
                            tabindex="0"
                            aria-label="Sunset horizons - Click to flip"
                        >
                            <div class="wild-card-inner">
                                <div class="wild-card-front">
                                    <img
                                        src="/images/about/sunset2.webp"
                                        alt="Soft sunset gradient"
                                    />
                                    <span class="flip-hint" aria-hidden="true"
                                        >flip ↺</span
                                    >
                                </div>
                                <div class="wild-card-back">
                                    <div
                                        class="wild-card-tape"
                                        aria-hidden="true"
                                    >
                                    </div>
                                    <h3 class="wild-card-title">
                                        Sunsets (again)
                                    </h3>
                                    <p class="wild-card-blurb">
                                        Nature makes the best color palettes.
                                        This one literally looks like heaven.
                                    </p>
                                    <span class="wild-card-tag"
                                        >📍 Pine Mountain Lake, CA</span
                                    >
                                </div>
                            </div>
                        </div>

                        <!-- Card 7 -->
                        <div
                            class="wild-card placeholder"
                            role="button"
                            tabindex="0"
