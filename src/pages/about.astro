                        <!-- Card 8 -->
                        <div
                            class="wild-card placeholder"
                            role="button"
                            tabindex="0"
                            aria-label="Community event hosting - Click to flip"
                        >
                            <div class="wild-card-inner">
                                <div class="wild-card-front">
                                    <img
                                        src="/images/about/event_hosting.webp"
                                        alt="Tvisha hosting community events"
                                    />
                                    <span class="flip-hint" aria-hidden="true"
                                        >flip ↺</span
                                    >
                                </div>
                                <div class="wild-card-back">
                                    <div
                                        class="wild-card-tape"
                                        aria-hidden="true"
                                    >
                                    </div>
                                    <h3 class="wild-card-title">
                                        Community Builder
                                    </h3>
                                    <p class="wild-card-blurb">
                                        Bringing creatives and designers
                                        together back in college and now in the
                                        Bay Area fuels so much of what I do.
                                    </p>
                                    <span class="wild-card-tag"
                                        >📍 Santa Barbara, CA</span
                                    >
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </BaseLayout>
        </div>
        <div class="copy-toast" role="status">Email copied</div>
        <script>
            // Declare active playback states across global bindings
            let isPlaying = false;
            let player: any = null;

            const turntable = document.getElementById("turntable");
            const musicPlayer = document.querySelector(".music-player");

            // ==========================================
            // INPUT YOUR YOUTUBE URL OR VIDEO ID HERE
            // ==========================================
            const youtubeSource = "https://www.youtube.com/watch?v=FXultmvqvyA";

            function getYoutubeId(url: string) {
                const match = url.match(
                    /(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=))([^&?]+)/,
                );
                return match ? match[1] : null;
            }

            const youtubeId = getYoutubeId(youtubeSource);

            // Safely mount and asynchronously load the external YouTube SDK pipeline
            function loadYoutubeAPI() {
                if (!youtubeId) return;

                // Check if script is already rendered globally
                if (!window.hasOwnProperty("YT")) {
                    const tag = document.createElement("script");
                    tag.src = "https://www.youtube.com/iframe_api";

                    // FIX: Added explicit [0] index to target the actual script element in the collection
                    const firstScriptTag =
                        document.getElementsByTagName("script")[0];
                    if (firstScriptTag && firstScriptTag.parentNode) {
                        firstScriptTag.parentNode.insertBefore(
                            tag,
                            firstScriptTag,
                        );
                    } else {
                        // Fallback if no script tag exists inside the head structure yet
                        document.head.appendChild(tag);
                    }
                }

                // Assign global initialization lifecycle hook
                (window as any).onYouTubeIframeAPIReady = () => {
                    player = new (window as any).YT.Player("player-container", {
                        height: "0",
                        width: "0",
                        videoId: youtubeId,
                        playerVars: {
                            playsinline: 1,
                            controls: 0,
                            disablekb: 1,
                            enablejsapi: 1,
                        },
                        events: {
                            onStateChange: onPlayerStateChange,
                            onError: (e: any) =>
                                console.error("YouTube Player Error:", e),
                        },
                    });
                };
            }

            // Handle cross-window message data notifications automatically
            function onPlayerStateChange(event: any) {
                // State 0 indicates the track payload finished playing natively
                if (event.data === 0) {
                    setPlaybackState(false);
                }
            }

            // Handle synchronized UI mutations smoothly
            function setPlaybackState(play: boolean) {
                if (!turntable) return;

                // Fail-safe protection layer: If player isn't fully initialized by the API yet, skip commands
                if (!player || typeof player.playVideo !== "function") {
                    console.warn(
                        "YouTube API is still initializing. Please wait a moment.",
                    );
                    return;
                }

                isPlaying = play;

                if (isPlaying) {
                    turntable.classList.add("playing");
                    if (musicPlayer) musicPlayer.classList.add("is-playing");
                    turntable.title = "Pause 'big feelings'";
                    player.playVideo();
                } else {
                    turntable.classList.remove("playing");
                    if (musicPlayer) musicPlayer.classList.remove("is-playing");
                    turntable.title = "Play 'big feelings'";
                    player.pauseVideo();
                }
            }

            // Bind interaction event streams
            if (turntable) {
                turntable.addEventListener("click", () => {
                    setPlaybackState(!isPlaying);
                });

                // Boot sequence integration
                loadYoutubeAPI();
            }

            // ==========================================
            // POLAROID FLIP CARD INTERACTION (Click/Tap)
            // ==========================================
            const wildCards = document.querySelectorAll(".wild-card");
            wildCards.forEach((card) => {
                const toggleFlip = () => {
                    card.classList.toggle("is-flipped");
                };

                card.addEventListener("click", toggleFlip);

                // Keyboard accessibility (Enter or Space to flip)
                card.addEventListener("keydown", (e: any) => {
                    if (e.key === "Enter" || e.key === " ") {
                        e.preventDefault();
                        toggleFlip();
                    }
                });
            });
        </script>
    </body>
</html>
