---
import CustomCursor from "../components/CustomCursor.astro";
import "../css/design-system.css";

const canonicalURL = new URL(
    Astro.url.pathname,
    Astro.site || "https://tvishapatel.com",
);
const imageURL = new URL(
    "/images/og-image.webp",
    Astro.site || "https://tvishapatel.com",
);
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Design System — Tvisha Patel</title>
        <meta
            name="description"
            content="How I designed this site: the colors, type, spacing, and tiny interactions behind it."
        />
        <link rel="canonical" href={canonicalURL} />
        <link rel="icon" href="/portfolio-favicon.webp" />

        <!-- Font Preconnect for Faster First Paint -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

        <!-- Open Graph / Facebook / LinkedIn -->
        <meta property="og:type" content="article" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content="Design System — Tvisha Patel" />
        <meta
            property="og:description"
            content="How I designed this site: the colors, type, spacing, and tiny interactions behind it."
        />
        <meta property="og:image" content={imageURL} />

        <!-- Twitter / X -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:url" content={canonicalURL} />
        <meta name="twitter:title" content="Design System — Tvisha Patel" />
        <meta
            name="twitter:description"
            content="How I designed this site: the colors, type, spacing, and tiny interactions behind it."
        />
        <meta name="twitter:image" content={imageURL} />
    </head>

    <body>
        <div class="cs-page">
            <main class="cs-grid">
                <!-- ======== SIDEBAR (EXACT 1:1 MATCH TO CASE STUDY) ======== -->
                <aside class="cs-sidebar">
                    <a
                        href="/playground"
                        class="cs-back"
                        data-cursor-pill="Back"
                    >
                        <svg
                            focusable="false"
                            aria-hidden="true"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20z"
                                fill="currentColor"></path>
                        </svg>
                        Back
                    </a>

                    <nav
                        class="cs-nav"
                        id="csSidebarNav"
                        aria-label="Design system navigation"
                    >
                        <ul>
                            <li>
                                <a href="#overview" class="nav-link">Overview</a
                                >
                            </li>
                            <li>
                                <a href="#colors" class="nav-link">Colors</a>
                            </li>
                            <li>
                                <a href="#typography" class="nav-link"
                                    >Typography</a
                                >
                            </li>
                            <li>
                                <a href="#spacing" class="nav-link">Spacing</a>
                            </li>
                            <li>
                                <a href="#components" class="nav-link"
                                    >Building Blocks</a
                                >
                            </li>
                            <li>
                                <a href="#cursor" class="nav-link"
                                    >Little Details</a
                                >
                            </li>
                        </ul>
                    </nav>
                </aside>

                <!-- ======== MAIN CONTENT COLUMN ======== -->
                <div class="cs-content">
                    <!-- OVERVIEW SECTION -->
                    <section id="overview" class="cs-section">
                        <h4 class="section-label">Overview</h4>
                        <h1>How I built this site</h1>
                        <p class="cs-hero-lede">
                            A peek behind the curtain: the colors, fonts,
                            spacing rules, and tiny details that make this site
                            feel like mine.
                        </p>

                        <p>
                            My goal going into coding this was simple: make it
                            feel like me. Structured and modern, but still
                            playful at its core. The warm cream background,
                            terracotta accents, handwritten moments, and custom
                            cursor were all picked to make browsing feel
                            welcoming (and a little fun).
                        </p>

                        <!-- Implementation Copy & Compliance -->
                        <div class="ds-implementation">
                            <h4
                                class="section-label"
                                style="font-size: 0.875rem;"
                            >
                                Implementation
                            </h4>
                            <p class="ds-implementation-text">
                                Built from scratch with Astro and CSS, with
                                accessible contrast baked in:
                            </p>
                            <div class="ds-compliance-item">
                                <svg
                                    class="ds-check-icon"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <polyline points="20 6 9 17 4 12"
                                    ></polyline>
                                </svg>
                                <span
                                    >WCAG AAA contrast: 11.69:1
                                    text-to-background ratio</span
                                >
                            </div>
                        </div>

                        <div class="section-divider"></div>
                    </section>

                    <!-- 01. COLOR PALETTE -->
                    <section id="colors" class="cs-section">
                        <h4 class="section-label">Colors</h4>
                        <h2>Colors & Contrast</h2>
                        <p>
                            Warm cream as the canvas, soft charcoal for reading,
                            and one terracotta accent that says "look here."
                        </p>

                        <div class="ds-color-grid">
                            <!-- Warm Canvas -->
                            <div
                                class="ds-color-card"
                                data-copy="#fefdfb"
                                data-cursor-pill="Copy HEX"
                            >
                                <div
                                    class="ds-color-swatch"
                                    style="background: #fefdfb;"
                                >
                                </div>
                                <div class="ds-color-info">
                                    <div class="ds-color-name-row">
                                        <span class="ds-color-name"
                                            >Warm Canvas</span
                                        >
                                        <span class="ds-color-hex">#fefdfb</span
                                        >
                                    </div>
                                    <span class="ds-color-var"
                                        >var(--color-bg)</span
                                    >
                                    <p class="ds-color-usage">
                                        Main page background, cards, and modal
                                        surfaces.
                                    </p>
                                </div>
                            </div>

                            <!-- Soft Charcoal -->
                            <div
                                class="ds-color-card"
                                data-copy="#3b3636"
                                data-cursor-pill="Copy HEX"
                            >
                                <div
                                    class="ds-color-swatch"
                                    style="background: #3b3636;"
                                >
                                </div>
                                <div class="ds-color-info">
                                    <div class="ds-color-name-row">
                                        <span class="ds-color-name"
                                            >Soft Charcoal</span
                                        >
                                        <span class="ds-color-hex">#3b3636</span
                                        >
                                    </div>
                                    <span class="ds-color-var"
                                        >var(--color-text)</span
                                    >
                                    <p class="ds-color-usage">
                                        Body text, titles, navigation links, and
                                        icons.
                                    </p>
                                </div>
                            </div>

                            <!-- Terracotta Accent -->
                            <div
                                class="ds-color-card"
                                data-copy="#a13900"
                                data-cursor-pill="Copy HEX"
                            >
                                <div
                                    class="ds-color-swatch"
                                    style="background: #a13900;"
                                >
                                </div>
                                <div class="ds-color-info">
                                    <div class="ds-color-name-row">
                                        <span class="ds-color-name"
                                            >Terracotta</span
                                        >
                                        <span class="ds-color-hex">#a13900</span
                                        >
                                    </div>
                                    <span class="ds-color-var"
                                        >var(--color-accent)</span
                                    >
                                    <p class="ds-color-usage">
                                        Primary buttons, active links, and
                                        custom cursor.
                                    </p>
                                </div>
                            </div>

                            <!-- Deep Terracotta -->
                            <div
                                class="ds-color-card"
                                data-copy="#8a3000"
                                data-cursor-pill="Copy HEX"
                            >
                                <div
                                    class="ds-color-swatch"
                                    style="background: #8a3000;"
                                >
                                </div>
                                <div class="ds-color-info">
                                    <div class="ds-color-name-row">
                                        <span class="ds-color-name"
                                            >Deep Terracotta</span
                                        >
                                        <span class="ds-color-hex">#8a3000</span
                                        >
                                    </div>
                                    <span class="ds-color-var"
                                        >button:hover</span
                                    >
                                    <p class="ds-color-usage">
                                        Pressed and hovered state for buttons
                                        and links.
                                    </p>
                                </div>
                            </div>

                            <!-- Placeholder Grey -->
                            <div
                                class="ds-color-card"
                                data-copy="#d9d9d9"
                                data-cursor-pill="Copy HEX"
                            >
                                <div
                                    class="ds-color-swatch"
                                    style="background: #d9d9d9;"
                                >
                                </div>
                                <div class="ds-color-info">
                                    <div class="ds-color-name-row">
                                        <span class="ds-color-name"
                                            >Placeholder Grey</span
                                        >
                                        <span class="ds-color-hex">#d9d9d9</span
                                        >
                                    </div>
                                    <span class="ds-color-var"
                                        >var(--color-placeholder)</span
                                    >
                                    <p class="ds-color-usage">
                                        Image skeletons and fallback media
                                        containers.
                                    </p>
                                </div>
                            </div>

                            <!-- Frame Neutral -->
                            <div
                                class="ds-color-card"
                                data-copy="#e8e4de"
                                data-cursor-pill="Copy HEX"
                            >
                                <div
                                    class="ds-color-swatch"
                                    style="background: #e8e4de;"
                                >
                                </div>
                                <div class="ds-color-info">
                                    <div class="ds-color-name-row">
                                        <span class="ds-color-name"
                                            >Frame Neutral</span
                                        >
                                        <span class="ds-color-hex">#e8e4de</span
                                        >
                                    </div>
                                    <span class="ds-color-var"
                                        >var(--cover-inset)</span
                                    >
                                    <p class="ds-color-usage">
                                        Subtle border insets around playground
                                        cards.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Contrast Callout (SVG Icon, No Emojis) -->
                        <div class="ds-callout">
                            <svg
                                class="ds-callout-icon"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="16" x2="12" y2="12"></line>
                                <line x1="12" y1="8" x2="12.01" y2="8"></line>
                            </svg>
                            <div class="ds-callout-text">
                                <h4>Contrast Standards</h4>
                                <p>
                                    Charcoal (<code>#3b3636</code>) on cream (<code
                                        >#fefdfb</code
                                    >) scores a <strong
                                        >11.69:1 contrast ratio</strong
                                    > (exceeding WCAG AAA). Cream text on Terracotta
                                    buttons scores <strong>6.66:1</strong> (passing
                                    WCAG AA for normal text and AAA for large text).
                                </p>
                            </div>
                        </div>

                        <div class="section-divider"></div>
                    </section>

                    <!-- 02. TYPOGRAPHY -->
                    <section id="typography" class="cs-section">
                        <h4 class="section-label">Typography</h4>
                        <h2>The Three Type Voices</h2>
                        <p>
                            Three fonts, three jobs: Geom for big, confident
                            headlines, Figtree for easy reading, and Gloria
                            Hallelujah for the handwritten notes-to-self
                            moments.
                        </p>

                        <div class="ds-type-voices">
                            <!-- Geom -->
                            <div class="ds-type-voice-card">
                                <span class="ds-type-voice-badge"
                                    >Display & Headings</span
                                >
                                <div class="ds-type-sample geom">Geom</div>
                                <p class="ds-type-voice-role">
                                    Page titles, section headings, and the hero.
                                    Its subtle geometric cuts give everything a
                                    confident, structured feel.
                                </p>
                            </div>

                            <!-- Figtree -->
                            <div class="ds-type-voice-card">
                                <span class="ds-type-voice-badge"
                                    >Body & UI</span
                                >
                                <div class="ds-type-sample figtree">
                                    Figtree
                                </div>
                                <p class="ds-type-voice-role">
                                    My default for paragraphs, case studies,
                                    buttons, and nav. Friendly and easy to read
                                    at any size.
                                </p>
                            </div>

                            <!-- Gloria Hallelujah -->
                            <div class="ds-type-voice-card">
                                <span class="ds-type-voice-badge"
                                    >Personal Accents</span
                                >
                                <div class="ds-type-sample gloria">
                                    Gloria Hallelujah
                                </div>
                                <p class="ds-type-voice-role">
                                    Used sparingly for doodle-style annotations,
                                    arrows, and little notes from me.
                                </p>
                            </div>
                        </div>

                        <!-- Live Interactive Type Tester -->
                        <div class="ds-playground-card">
                            <div class="ds-playground-header">
                                <div class="ds-playground-badge">
                                    <span>Interactive Area</span>
                                </div>
                                <span class="ds-playground-hint"
                                    >Type below & switch font tabs</span
                                >
                            </div>
                            <div class="ds-playground-body">
                                <div class="ds-type-tester-controls">
                                    <input
                                        type="text"
                                        id="dsTypeInput"
                                        class="ds-type-tester-input"
                                        value="Hey, I’m Tvisha"
                                        placeholder="Type something to preview..."
                                        aria-label="Text to preview"
                                    />
                                    <div
                                        class="ds-type-tester-font-tabs"
                                        role="tablist"
                                    >
                                        <button
                                            type="button"
                                            class="ds-font-btn is-active"
                                            data-font="geom">Geom</button
                                        >
                                        <button
                                            type="button"
                                            class="ds-font-btn"
                                            data-font="figtree">Figtree</button
                                        >
                                        <button
                                            type="button"
                                            class="ds-font-btn"
                                            data-font="gloria"
                                            >Gloria Hallelujah</button
                                        >
                                    </div>
                                </div>
                                <div class="ds-type-preview-box">
                                    <p
                                        class="ds-type-preview-text"
                                        id="dsTypePreview"
                                        style="font-family: var(--cs-font-display);"
                                    >
                                        Hey, I’m Tvisha
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Fluid Scale Table -->
                        <div class="ds-scale-table-wrap">
                            <table class="ds-scale-table">
                                <thead>
                                    <tr>
                                        <th>Token</th>
                                        <th>CSS Fluid Clamp</th>
                                        <th>Min → Max Size</th>
                                        <th>Used For</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><code>--text-hero</code></td>
                                        <td
                                            ><code
                                                >clamp(3rem, 6vw, 4.5rem)</code
                                            ></td
                                        >
                                        <td>48px → 72px</td>
                                        <td>Home hero title</td>
                                    </tr>
                                    <tr>
                                        <td><code>--text-title</code></td>
                                        <td
                                            ><code
                                                >clamp(1.75rem, 2.5vw, 2.25rem)</code
                                            ></td
                                        >
                                        <td>28px → 36px</td>
                                        <td>Section titles, project cards</td>
                                    </tr>
                                    <tr>
                                        <td><code>--text-section</code></td>
                                        <td
                                            ><code
                                                >clamp(1.25rem, 2vw, 1.5rem)</code
                                            ></td
                                        >
                                        <td>20px → 24px</td>
                                        <td>Subheadings, page headings</td>
                                    </tr>
                                    <tr>
                                        <td><code>--text-body</code></td>
                                        <td
                                            ><code
                                                >clamp(1.125rem, 1.7vw, 1.5rem)</code
                                            ></td
                                        >
                                        <td>18px → 24px</td>
                                        <td>Body copy, ledes, buttons</td>
                                    </tr>
                                    <tr>
                                        <td><code>--text-nav</code></td>
                                        <td
                                            ><code
                                                >clamp(1.05rem, 1.6vw, 1.5rem)</code
                                            ></td
                                        >
                                        <td>16.8px → 24px</td>
                                        <td>Site navigation links</td>
                                    </tr>
                                    <tr>
                                        <td><code>--text-small</code></td>
                                        <td><code>1rem</code></td>
                                        <td>16px</td>
                                        <td>Captions, metadata, hints</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="section-divider"></div>
                    </section>

                    <!-- 03. SPACING & RADII -->
                    <section id="spacing" class="cs-section">
                        <h4 class="section-label">Spacing</h4>
                        <h2>Spacing & Rhythm</h2>
                        <p>
                            Everything snaps to a 4px/8px scale, so spacing
                            stays consistent from phone to desktop.
                        </p>

                        <div class="ds-space-grid">
                            <div class="ds-space-row">
                                <span class="ds-space-token">--space-4</span>
                                <span class="ds-space-val">4px</span>
                                <div
                                    class="ds-space-visual"
                                    style="width: 4px;"
                                >
                                </div>
                            </div>
                            <div class="ds-space-row">
                                <span class="ds-space-token">--space-8</span>
                                <span class="ds-space-val">8px</span>
                                <div
                                    class="ds-space-visual"
                                    style="width: 8px;"
                                >
                                </div>
                            </div>
                            <div class="ds-space-row">
                                <span class="ds-space-token">--space-12</span>
                                <span class="ds-space-val">12px</span>
                                <div
                                    class="ds-space-visual"
                                    style="width: 12px;"
                                >
                                </div>
                            </div>
                            <div class="ds-space-row">
                                <span class="ds-space-token">--space-16</span>
                                <span class="ds-space-val">16px</span>
                                <div
                                    class="ds-space-visual"
                                    style="width: 16px;"
                                >
                                </div>
                            </div>
                            <div class="ds-space-row">
                                <span class="ds-space-token">--space-24</span>
                                <span class="ds-space-val">24px</span>
                                <div
                                    class="ds-space-visual"
                                    style="width: 24px;"
                                >
                                </div>
                            </div>
                            <div class="ds-space-row">
                                <span class="ds-space-token">--space-32</span>
                                <span class="ds-space-val">32px</span>
                                <div
                                    class="ds-space-visual"
                                    style="width: 32px;"
                                >
                                </div>
                            </div>
                            <div class="ds-space-row">
                                <span class="ds-space-token">--space-48</span>
                                <span class="ds-space-val">48px</span>
                                <div
                                    class="ds-space-visual"
                                    style="width: 48px;"
                                >
                                </div>
                            </div>
                            <div class="ds-space-row">
                                <span class="ds-space-token">--space-80</span>
                                <span class="ds-space-val">80px</span>
                                <div
                                    class="ds-space-visual"
                                    style="width: 80px;"
                                >
                                </div>
                            </div>
                        </div>

                        <!-- Unified Corner Radii with constrained max-width -->
                        <div class="ds-radii-grid">
                            <div class="ds-radius-card">
                                <div
                                    class="ds-radius-box"
                                    style="border-radius: 4px;"
                                >
                                    4px
                                </div>
                                <h4>Unified 4px Radius</h4>
                                <p class="ds-color-usage">
                                    <code>var(--radius-card)</code> & <code
                                        >var(--radius-btn)</code
                                    > One corner radius for buttons, cards, and image
                                    frames to make everything feel intentional.
                                </p>
                            </div>
                        </div>

                        <div class="section-divider"></div>
                    </section>

                    <!-- 04. COMPONENTS -->
                    <section id="components" class="cs-section">
                        <h4 class="section-label">Building Blocks</h4>
                        <h2>Core Components</h2>
                        <p>The small building blocks I reuse on every page.</p>

                        <div class="ds-components-grid">
                            <!-- Primary Button -->
                            <div class="ds-component-box">
                                <div class="ds-component-stage">
                                    <button type="button" class="btn-sample"
                                        >Primary Button</button
                                    >
                                </div>
                                <div class="ds-component-info">
                                    <h4 class="ds-component-title">
                                        Primary Button (<code>.btn</code>)
                                    </h4>
                                    <p class="ds-component-desc">
                                        Terracotta fill, cream text, 4px
                                        corners. Used for the main actions, like
                                        LinkedIn and copying my email.
                                    </p>
                                </div>
                            </div>

                            <!-- Links & Accents -->
                            <div class="ds-component-box">
                                <div
                                    class="ds-component-stage"
                                    style="flex-direction: column; align-items: flex-start; gap: 12px;"
                                >
                                    <span
                                        class="link-sample-dotted"
                                        role="link"
                                        tabindex="0"
                                        data-cursor-hand
                                    >
                                        Case study reference
                                    </span>
                                    <span
                                        class="link-sample-external"
                                        role="link"
                                        tabindex="0"
                                        data-cursor-hand
                                    >
                                        Open live prototype
                                        <svg
                                            class="external-arrow"
                                            viewBox="0 0 12 12"
                                            aria-hidden="true"
                                        >
                                            <path d="M3.5 1.5h7v7M10.5 1.5L2 10"
                                            ></path>
                                        </svg>
                                    </span>
                                </div>
                                <div class="ds-component-info">
                                    <h4 class="ds-component-title">
                                        Link Styles
                                    </h4>
                                    <p class="ds-component-desc">
                                        All links have a terracotta dotted
                                        underline, plus a small arrow for
                                        external links.
                                    </p>
                                </div>
                            </div>

                            <!-- Mascot & Sparkle -->
                            <div class="ds-component-box">
                                <div class="ds-component-stage">
                                    <img
                                        src="/images/computer-image.svg"
                                        alt="Illustration of Tvisha working on a laptop"
                                        style="width: 44px; height: 44px;"
                                    />
                                    <span
                                        style="font-family: var(--cs-font-hand); font-size: 1.25rem; color: var(--cs-accent);"
                                        >✧✶</span
                                    >
                                </div>
                                <div class="ds-component-info">
                                    <h4 class="ds-component-title">
                                        Brand Accents
                                    </h4>
                                    <p class="ds-component-desc">
                                        My girl-at-a-laptop doodle is the home
                                        logo and footer sign-off, and the
                                        sparkles (✧✶) pop up next to the hero
                                        section text.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="section-divider"></div>
                    </section>

                    <!-- 05. CURSOR & MICRO-INTERACTIONS -->
                    <section id="cursor" class="cs-section">
                        <h4 class="section-label">Little Details</h4>
                        <h2>The Cursor & Interaction Details</h2>
                        <p>
                            These are the tiny details designed to make the site
                            feel alive. My custom cursor changes shape depending
                            on what you're about to click.
                        </p>

                        <!-- Interactive Cursor Playground (Solid Borders) -->
                        <div class="ds-playground-card">
                            <div class="ds-playground-header">
                                <div class="ds-playground-badge">
                                    <span>Interactive Area</span>
                                </div>
