        <!-- ======== SCROLLSPY & INTERACTION SCRIPT ======== -->
        <script>
            // Exact scrollspy logic from caseStudyLayout.astro
            document.addEventListener("DOMContentLoaded", () => {
                const navLinks = Array.from(
                    document.querySelectorAll(".cs-nav .nav-link"),
                );
                if (navLinks.length === 0) return;

                let targets: Array<{ link: Element; el: HTMLElement }> = [];

                function refreshTargets() {
                    targets = navLinks
                        .map((link) => {
                            const href = link.getAttribute("href");
                            if (!href || !href.startsWith("#")) return null;
                            const id = href.slice(1);
                            const el = document.getElementById(id);
                            return el ? { link, el } : null;
                        })
                        .filter(
                            (
                                item,
                            ): item is { link: Element; el: HTMLElement } =>
                                item !== null,
                        );
                }

                refreshTargets();

                function updateActiveLink() {
                    if (targets.length === 0) {
                        refreshTargets();
                    }
                    if (targets.length === 0) return;

                    const scrollPosition = window.scrollY;
                    const windowHeight = window.innerHeight;
                    const documentHeight =
                        document.documentElement.scrollHeight;

                    // If user is at or near the bottom of the page, activate the last section
                    if (windowHeight + scrollPosition >= documentHeight - 60) {
                        setActive(targets[targets.length - 1].link);
                        return;
                    }

                    // A section is active when its top is at or above the threshold
                    const threshold = Math.max(100, windowHeight * 0.25);

                    let currentTarget = targets[0];
                    for (let i = 0; i < targets.length; i++) {
                        const rect = targets[i].el.getBoundingClientRect();
                        if (rect.top <= threshold) {
                            currentTarget = targets[i];
                        } else {
                            break;
                        }
                    }

                    setActive(currentTarget.link);
                }

                function setActive(activeLink: Element) {
                    navLinks.forEach((link) => {
                        if (link === activeLink) {
                            link.classList.add("active");
                        } else {
                            link.classList.remove("active");
                        }
                    });
                }

                window.addEventListener("scroll", updateActiveLink, {
                    passive: true,
                });
                updateActiveLink();

                // Copy email functionality
                document
                    .querySelectorAll(".copy-email, [data-copy]")
                    .forEach((btn) => {
                        btn.addEventListener("click", async () => {
                            const email =
                                btn.getAttribute("data-copy") ||
                                "tvishapatel0@gmail.com";
                            try {
                                await navigator.clipboard.writeText(email);
                            } catch (err) {
                                const textarea =
                                    document.createElement("textarea");
                                textarea.value = email;
                                textarea.style.position = "fixed";
                                textarea.style.opacity = "0";
                                document.body.appendChild(textarea);
                                textarea.select();
                                document.execCommand("copy");
                                document.body.removeChild(textarea);
                            }
                        });
                    });
            });

            // Live Type Tester Script
            const typeInput = document.getElementById(
                "dsTypeInput",
            ) as HTMLInputElement | null;
            const typePreview = document.getElementById("dsTypePreview");
            const fontButtons = document.querySelectorAll(".ds-font-btn");

            if (typeInput && typePreview) {
                typeInput.addEventListener("input", (e) => {
                    const val = (e.target as HTMLInputElement).value;
                    typePreview.textContent =
                        val.trim() === ""
                            ? "Type something to preview..."
                            : val;
                });
            }

            fontButtons.forEach((btn) => {
                btn.addEventListener("click", () => {
                    fontButtons.forEach((b) => b.classList.remove("is-active"));
                    btn.classList.add("is-active");

                    const font = btn.getAttribute("data-font");
                    if (!typePreview) return;

                    if (font === "geom") {
                        typePreview.style.fontFamily = "var(--cs-font-display)";
                        typePreview.style.fontWeight = "700";
                    } else if (font === "figtree") {
                        typePreview.style.fontFamily = "var(--cs-font)";
                        typePreview.style.fontWeight = "600";
                    } else if (font === "gloria") {
                        typePreview.style.fontFamily = "var(--cs-font-hand)";
                        typePreview.style.fontWeight = "400";
                    }
                });
            });

            // Mini Turntable Interactive Audio & Preview
            const turntableTrigger =
                document.getElementById("dsTurntableTrigger");
            let dsPlayer: any = null;
            let isAudioPlaying = false;
            let isPlayerReady = false;
            let pendingPlay = false;

            function loadYouTubeSDK() {
                if ((window as any).YT && (window as any).YT.Player) {
                    initTurntableAudio();
                    return;
                }

                const prevReady = (window as any).onYouTubeIframeAPIReady;
                (window as any).onYouTubeIframeAPIReady = () => {
                    if (typeof prevReady === "function") prevReady();
                    initTurntableAudio();
                };

                if (
                    !document.querySelector(
                        'script[src*="youtube.com/iframe_api"]',
                    )
                ) {
                    const tag = document.createElement("script");
                    tag.src = "https://www.youtube.com/iframe_api";
                    const firstScriptTag =
                        document.getElementsByTagName("script")[0];
                    if (firstScriptTag && firstScriptTag.parentNode) {
                        firstScriptTag.parentNode.insertBefore(
                            tag,
                            firstScriptTag,
                        );
                    } else {
                        document.head.appendChild(tag);
                    }
                }
            }

            function initTurntableAudio() {
                if (!document.getElementById("ds-player-container")) return;
                try {
                    dsPlayer = new (window as any).YT.Player(
                        "ds-player-container",
                        {
                            height: "0",
                            width: "0",
                            videoId: "FXultmvqvyA",
                            playerVars: {
                                playsinline: 1,
                                controls: 0,
                                disablekb: 1,
                                enablejsapi: 1,
                            },
                            events: {
                                onReady: () => {
                                    isPlayerReady = true;
                                    if (pendingPlay) {
                                        pendingPlay = false;
                                        if (
                                            dsPlayer &&
                                            typeof dsPlayer.playVideo ===
                                                "function"
                                        ) {
                                            dsPlayer.playVideo();
                                        }
                                    }
                                },
                                onStateChange: (event: any) => {
                                    if (event.data === 0) {
                                        // Track ended natively
                                        setTurntablePlayback(false);
                                    }
                                },
                                onError: (e: any) => {
                                    console.warn("Turntable audio note:", e);
                                },
                            },
                        },
                    );
                } catch (err) {
                    console.warn("Could not init YouTube player", err);
                }
            }

            function setTurntablePlayback(play: boolean) {
                isAudioPlaying = play;
                if (!turntableTrigger) return;

                if (isAudioPlaying) {
                    turntableTrigger.classList.add("is-playing");
                    turntableTrigger.setAttribute(
                        "data-cursor-pill",
                        "Pause ⏸",
                    );
                    if (
                        isPlayerReady &&
                        dsPlayer &&
                        typeof dsPlayer.playVideo === "function"
                    ) {
                        dsPlayer.playVideo();
                    } else {
                        pendingPlay = true;
                        loadYouTubeSDK();
                    }
                } else {
                    turntableTrigger.classList.remove("is-playing");
                    turntableTrigger.setAttribute(
                        "data-cursor-pill",
                        "Click to Spin ♫",
                    );
                    pendingPlay = false;
                    if (
                        isPlayerReady &&
                        dsPlayer &&
                        typeof dsPlayer.pauseVideo === "function"
                    ) {
                        dsPlayer.pauseVideo();
                    }
                }

                const activeCursorText = document.querySelector(
                    ".custom-cursor-pill-text",
                );
                if (activeCursorText && turntableTrigger.matches(":hover")) {
                    activeCursorText.textContent = isAudioPlaying
                        ? "Pause ⏸"
                        : "Click to Spin ♫";
                }
            }

            if (turntableTrigger) {
                loadYouTubeSDK();

                turntableTrigger.addEventListener("click", () => {
                    setTurntablePlayback(!isAudioPlaying);
                });

                turntableTrigger.addEventListener(
                    "keydown",
                    (e: KeyboardEvent) => {
                        if (e.key === "Enter" || e.key === " ") {
                            e.preventDefault();
                            setTurntablePlayback(!isAudioPlaying);
                        }
                    },
                );
            }

            // Mini Polaroid Flip Card Interaction
            const flipTrigger = document.getElementById("dsFlipTrigger");
            const flipCard = document.getElementById("dsMiniFlipCard");
            if (flipTrigger && flipCard) {
                const toggleCardFlip = () => {
                    const isFlipped = flipCard.classList.toggle("is-flipped");
                    const pillText = isFlipped
                        ? "Flip Back ↺"
                        : "Click to Flip ↺";
                    flipTrigger.setAttribute("data-cursor-pill", pillText);
                    const activeCursorText = document.querySelector(
                        ".custom-cursor-pill-text",
                    );
                    if (activeCursorText && flipTrigger.matches(":hover")) {
                        activeCursorText.textContent = pillText;
                    }
                };

                flipTrigger.addEventListener("click", toggleCardFlip);
                flipTrigger.addEventListener("keydown", (e: KeyboardEvent) => {
                    if (e.key === "Enter" || e.key === " ") {
                        e.preventDefault();
                        toggleCardFlip();
                    }
                });
            }
        </script>
