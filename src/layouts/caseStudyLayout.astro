---
// src/layouts/CaseStudyLayout.astro
const { frontmatter } = Astro.props;

// Destructure frontmatter with defaults
const {
    title = "",
    year = "",
    subtitle = "",
    heroImage = "",
    heroPoster = "",
    role = "",
    timeline = "",
    team = [],
    skills = [],
    sections = [],
    passwordProtected = false,
    description = "",
} = frontmatter;

// Fallback SEO description and title
const pageTitle = frontmatter.pageTitle || `${title} — Tvisha Patel`;
const metaDescription =
    description ||
    subtitle ||
    `${title} case study by Tvisha Patel, Product Designer.`;

// All case studies in viewing order
const allCaseStudies = [
    {
        company: "Strawberry.me",
        title: "0→1 Design for Coaching Platform",
        tagline: "$30M+ ARR • Dual-sided marketplace",
        slug: "strawberry",
        role: "Founding Product Designer",
        year: "2024–present",
        path: "/case-studies/strawberry",
    },
    {
        company: "Strawberry.me",
        title: "AI Message Draft Workflow",
        tagline: "60% → 92% follow-up rate",
        slug: "strawberry-ai",
        role: "Founding Product Designer",
        year: "2025",
        path: "/case-studies/strawberry-ai",
    },
    {
        company: "BetterHelp",
        title: "Simplifying the Video Session Test",
        tagline: "33% fewer clicks for 5M+ users",
        slug: "betterhelp",
        role: "Product Design Intern",
        year: "2023",
        path: "/case-studies/betterhelp",
    },
    {
        company: "EchoKids",
        title: "Mentor Dashboard & Design System",
        tagline: "+200% weekly returning mentors",
        slug: "echokids",
        role: "Product Design Intern",
        year: "2022",
        path: "/case-studies/echokids",
    },
];

// Determine current study and next/prev
const currentPath = Astro.url.pathname.replace(/\/$/, "");
const currentIndex = allCaseStudies.findIndex((cs) =>
    currentPath.endsWith(cs.slug),
);
const safeIndex = currentIndex !== -1 ? currentIndex : 0;
const nextCaseStudy = allCaseStudies[(safeIndex + 1) % allCaseStudies.length];
const prevCaseStudy =
    allCaseStudies[
        (safeIndex - 1 + allCaseStudies.length) % allCaseStudies.length
    ];

const canonicalURL = new URL(
    Astro.url.pathname,
    Astro.site || "https://tvishapatel.com",
);
const ogImage =
    heroPoster ||
    (heroImage && !heroImage.endsWith(".mp4") && !heroImage.endsWith(".webm")
        ? heroImage
        : "/images/og-image.webp");
const imageURL = new URL(ogImage, Astro.site || "https://tvishapatel.com");

import CustomCursor from "../components/CustomCursor.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{pageTitle}</title>
        <meta name="description" content={metaDescription} />
        <link rel="canonical" href={canonicalURL} />
        <link rel="icon" href="/portfolio-favicon.webp" />

        <!-- Font Preconnect for Faster First Paint -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

        <!-- Open Graph / Facebook / LinkedIn -->
        <meta property="og:type" content="article" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={metaDescription} />
        <meta property="og:image" content={imageURL} />

        <!-- Twitter / X -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:url" content={canonicalURL} />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={metaDescription} />
        <meta name="twitter:image" content={imageURL} />

        <style is:global>
            /* --- Google Fonts (matches rest of site) --- */
            @import url("https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300..900;1,300..900&family=Geom:ital,wght@0,300..900;1,300..900&display=swap");

            /* --- DESIGN TOKENS (customize these) --- */
            :root {
                --cs-bg: #ffffff;
                --cs-text: #1a1a1a;
                --cs-text-muted: #71717a;
                --cs-border: rgba(0, 0, 0, 0.1);
                --cs-accent: #6366f1;
                --cs-callout-border: #b0b0b0;
                --cs-font-display: "Geom", sans-serif;
                --cs-font: "Figtree", sans-serif;
            }

            /* --- RESET --- */
            *,
            *::before,
            *::after {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            html {
                scroll-behavior: smooth;
            }

            body {
                font-family: var(--cs-font);
                background-color: var(--cs-bg);
                color: var(--cs-text);
                line-height: 1.6;
            }

            h1,
            h2,
            h3,
            h4 {
                font-family: var(--cs-font-display);
            }

            /* ================================================
               MASTER 3-COLUMN GRID
               sidebar (auto) | content (auto) | spacer (1fr)
               ================================================ */
            .cs-page {
                min-height: 100vh;
                padding: 0 1.5rem;
            }

            .cs-grid {
                display: grid;
                max-width: 1800px;
                margin: 0 auto;
                grid-template-columns: 1fr;
                gap: 0;
            }

            @media (min-width: 768px) {
                .cs-grid {
                    grid-template-columns: auto auto 1fr;
                    gap: 2rem;
                }
            }

            /* ================================================
               STICKY SIDEBAR
               ================================================ */
            .cs-sidebar {
                padding: 3rem 0 0;
                min-width: 160px;
            }

            @media (min-width: 768px) {
                .cs-sidebar {
                    position: sticky;
                    top: 0;
                    height: fit-content;
                    padding: 3rem 0;
                }
            }

            /* Back link */
            .cs-back {
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                color: var(--cs-text);
                text-decoration: none;
                font-size: 0.875rem;
                font-weight: 500;
                opacity: 0.5;
                transition: opacity 0.2s ease;
            }

            .cs-back:hover {
                opacity: 1;
            }

            .cs-back svg {
                width: 18px;
                height: 18px;
            }

            /* Scrollspy navigation */
            .cs-nav {
                margin-top: 2rem;
                display: none;
            }

            @media (min-width: 768px) {
                .cs-nav {
                    display: block;
                }
            }

            .cs-nav ul {
                list-style: none;
                display: flex;
                flex-direction: column;
                align-items: flex-start;
                gap: 0.5rem;
            }

            .cs-nav a {
                color: var(--cs-text);
                text-decoration: none;
                font-size: 0.875rem;
                opacity: 0.5;
                transition:
                    color 0.2s ease,
                    opacity 0.2s ease;
                cursor: pointer;
                text-align: left;
            }

            .cs-nav a:hover {
                opacity: 1;
                color: var(--cs-text);
            }

            .cs-nav a.active {
                opacity: 1;
                color: var(--cs-text);
            }

            /* ================================================
               MAIN CONTENT COLUMN
               ================================================ */
            .cs-content {
                width: 100%;
                max-width: 896px;
                padding: 3rem 0;
                display: flex;
                flex-direction: column;
                gap: 3rem;
            }

            @media (min-width: 768px) {
                .cs-content {
                    gap: 6rem;
                }
            }

            @media (min-width: 1024px) {
                .cs-content {
                    max-width: 1024px;
                }
            }

            /* Right spacer (empty, for visual balance) */
            .cs-spacer {
                display: none;
            }

            @media (min-width: 768px) {
                .cs-spacer {
                    display: block;
                    padding: 3rem 0;
                }
            }

            /* ================================================
               HERO SECTION
               ================================================ */
            .cs-hero {
                display: flex;
                flex-direction: column;
                gap: 2rem;
            }

            .cs-hero-text {
                display: flex;
                flex-direction: column;
                gap: 1rem;
            }

            /* "ProjectName • Year" label */
            .cs-hero-label {
                font-size: 0.875rem;
                font-weight: 500;
                line-height: 1.4;
                color: var(--cs-text);
            }

            /* Main heading (subtitle field) */
            .cs-hero h1 {
                font-size: 2.25rem;
                line-height: 1.15;
                font-weight: 600;
                letter-spacing: -0.01em;
            }

            /* Hero image */
            .cs-hero-image {
                width: 100%;
                aspect-ratio: 2640 / 1338;
                border: 1px solid var(--cs-border);
                border-radius: 6px;
                overflow: hidden;
            }

            .cs-hero-image img,
            .cs-hero-image video {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
                margin: 0;
                border-radius: 0;
            }

            /* 4-column metadata row */
            .cs-meta {
                display: flex;
                flex-direction: column;
                gap: 1.5rem;
            }

            @media (min-width: 768px) {
                .cs-meta {
                    flex-direction: row;
                    gap: 3rem;
                }
            }

            .cs-meta-item {
                display: flex;
                flex-direction: column;
                gap: 0.5rem;
                flex: 1;
            }

            .cs-meta-item h4 {
                font-size: 0.875rem;
                font-weight: 600;
                line-height: 1.4;
                opacity: 1;
            }

            .cs-meta-item p {
                font-size: 1rem;
                line-height: 1.6;
                margin: 0;
            }

            .skills-list {
                list-style-type: disc;
                padding-left: 1.15rem;
                display: flex;
                flex-direction: column;
                gap: 0.35rem;
                margin: 0;
            }

            .skills-list li {
                font-size: 0.95rem;
                line-height: 1.5;
                color: var(--cs-text);
            }

            /* ================================================
               SECTION STRUCTURE
               ================================================ */
            .cs-section {
                display: flex;
                flex-direction: column;
                gap: 1rem;
                scroll-margin-top: 3rem;
            }

            /* Section label (h4 — "Overview", "Market Research", etc.) */
            .section-label {
                font-size: 1.125rem;
                font-weight: 600;
                line-height: 1.4;
                margin-bottom: 0.25rem;
            }

            /* Section heading (h2) */
            .cs-section h2 {
                font-size: 2rem;
                line-height: 1.3;
                font-weight: 600;
                margin-bottom: 0.25rem;
            }

            /* Sub-heading (h3) */
            .cs-section h3 {
                font-size: 1.25rem;
                line-height: 1.4;
                font-weight: 600;
                margin-top: 1.75rem;
            }

            .cs-section h2 + h3 {
                margin-top: 0.75rem;
            }

            /* Body text */
            .cs-section p {
                font-size: 1.125rem;
                line-height: 1.6;
            }

            .cs-section ul,
            .cs-section ol {
                padding-left: 1.5rem;
                display: flex;
                flex-direction: column;
                gap: 0.5rem;
                font-size: 1.125rem;
                line-height: 1.6;
            }

            .cs-section li {
                margin: 0;
            }

            .cs-section a {
                color: #a13900;
                text-decoration: underline;
                text-decoration-style: dotted;
                text-decoration-color: #a13900;
                text-decoration-thickness: 12.5%;
                text-underline-offset: 0.18em;
                transition: opacity 0.2s ease;
            }

            .cs-section a:hover {
                opacity: 0.75;
            }

            .cs-section a.external-link {
                display: inline-inline;
                align-items: baseline;
                gap: 0.3em;
                text-decoration: underline;
                text-decoration-style: dotted;
                text-decoration-color: #a13900;
                text-decoration-thickness: 12.5%;
                text-underline-offset: 0.18em;
            }

            .cs-section a .external-arrow {
                display: inline-block;
                width: 0.85em;
                height: 0.85em;
                margin-left: 0.3em;
                vertical-align: -0.05em;
                stroke: currentColor;
                stroke-width: 2.2;
                fill: none;
                stroke-linecap: round;
                stroke-linejoin: round;
                transition: transform 0.2s ease;
            }

            .cs-section a:hover .external-arrow {
                transform: translate(1.5px, -1.5px);
            }

            .cs-section code {
                font-family: monospace;
                background-color: #f3f4f6;
                padding: 0.15rem 0.4rem;
                border-radius: 4px;
                font-size: 0.9em;
            }

            /* Section divider */
            .section-divider {
                height: 1px;
                width: 100%;
                background-color: var(--cs-border);
                margin: 4rem 0 2rem;
            }

            /* ================================================
               UTILITY: MEDIA WITH SIDE CAPTION
               60% media | 40% caption on desktop, stacked on mobile
               ================================================ */
            .media-with-caption {
                width: 100%;
                display: flex;
                gap: 1.5rem;
                align-items: center;
                margin: 1rem 0;
            }

            .media-with-caption .media-content {
                display: grid;
                grid-template-columns: 1fr;
                gap: 2rem;
                width: 100%;
            }

            @media (min-width: 768px) {
                .media-with-caption .media-content {
                    grid-template-columns: 60% auto;
                    align-items: end;
                }
            }

            .media-with-caption .media-visual {
                width: 100%;
                border: 1px solid var(--cs-border);
                overflow: hidden;
            }

            .media-with-caption .media-visual img,
            .media-with-caption .media-visual video {
                width: 100%;
                height: auto;
                object-fit: cover;
                display: block;
                margin: 0;
                border-radius: 0;
            }

            .media-with-caption .media-caption {
                display: flex;
                flex-direction: column;
                height: fit-content;
            }

            .media-with-caption .media-caption h3 {
                font-size: 0.875rem;
                line-height: 1.4;
                margin-top: 0.5rem;
            }

            /* Mobile: show caption above media */
            .media-caption-mobile {
                display: block;
                padding-bottom: 1.5rem;
            }

            .media-caption-desktop {
                display: none;
            }

            @media (min-width: 768px) {
                .media-caption-mobile {
                    display: none;
                }

                .media-caption-desktop {
                    display: block;
                }
            }

            /* ================================================
               UTILITY: FULL-WIDTH MEDIA
               ================================================ */
            .full-width-media {
                width: 100%;
            }

            .full-width-media img,
            .full-width-media video {
                width: 100%;
                height: auto;
                object-fit: contain;
                display: block;
                margin: 0;
                border-radius: 0;
            }

            /* ================================================
               UTILITY: CALLOUT / BLOCKQUOTE
               ================================================ */
            .callout {
                font-style: italic;
                padding: 0;
                margin: 1.5rem 0;
                padding-left: 1rem;
                border-left: 2px solid var(--cs-callout-border);
            }

            .callout > :first-child {
                margin-top: 0;
            }

            .callout > :last-child {
                margin-bottom: 0;
            }

            .callout h3 {
                font-size: 1.125rem;
                line-height: 1.4;
                font-weight: 600;
                margin-top: 0;
            }

            .callout p {
                font-size: 1.125rem;
                line-height: 1.6;
                margin-top: 0.5rem;
            }

            /* ================================================
               UTILITY: MULTI-COLUMN CARDS
               (Pain Points, Reflections, etc.)
               ================================================ */
            .column-cards {
                display: flex;
                flex-direction: column;
                gap: 1.5rem;
                width: 100%;
                margin-top: 0.5rem;
            }

            @media (min-width: 768px) {
                .column-cards {
                    flex-direction: row;
                }
            }

            .column-card {
                display: flex;
                flex-direction: column;
                gap: 0.25rem;
                flex: 1;
            }

            .column-card h3 {
                font-size: 1.125rem;
                line-height: 1.4;
                font-weight: 600;
            }

            .column-card p {
                font-size: 1rem;
                line-height: 1.6;
            }

            /* ================================================
               UTILITY GRIDS
               ================================================ */
            .grid-2 {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 2rem;
                margin: 1.5rem 0;
            }

            .eval-list {
                list-style: none;
                padding: 0;
                margin: 0;
                display: flex;
                flex-direction: column;
                justify-content: center;
                gap: 1.25rem;
                align-self: center;
            }

            .eval-item {
                display: flex;
                align-items: flex-start;
                gap: 0.875rem;
                font-size: 1.05rem;
                line-height: 1.5;
                color: var(--cs-text);
            }

            .eval-icon {
                flex-shrink: 0;
                width: 22px;
                height: 22px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                margin-top: 1px;
            }

            .eval-icon svg {
                width: 20px;
                height: 20px;
                stroke-width: 2.25;
            }

            .eval-icon.eval-con {
                color: #e5534b;
            }

            .eval-icon.eval-pro {
                color: #38a169;
            }

            .eval-icon.eval-neutral {
                color: #e2941b;
            }

            /* ================================================
               IMPACT HOLDER COMPONENT (Image/Video container with label)
               Differentiating theme colors for image containers only
               ================================================ */
            .impact-holder {
                width: 100%;
                border-radius: 8px;
                padding: clamp(1.25rem, 3vw, 2.25rem);
                display: flex;
                flex-direction: column;
                gap: 1rem;
                margin: 2rem 0;
                box-sizing: border-box;
                background: var(--holder-bg, #f4f3f0);
                border: 1px solid var(--holder-border, rgba(0, 0, 0, 0.07));
            }

            .impact-holder.size-b {
                margin: 0;
                padding: clamp(0.85rem, 2vw, 1.35rem);
                gap: 0.75rem;
                border-radius: 8px;
            }

            .impact-holder .impact-label {
                font-family: var(--cs-font);
                font-size: clamp(0.95rem, 1.2vw, 1.05rem);
                font-weight: 500;
                letter-spacing: -0.01em;
                color: var(--holder-text, #2a2a2a);
                margin: 0;
                line-height: 1.35;
            }

            .impact-holder .impact-canvas {
                width: 100%;
                display: flex;
                justify-content: center;
                align-items: center;
                border-radius: 6px;
                overflow: hidden;
                background: #ffffff;
                border: 1px solid rgba(0, 0, 0, 0.06);
            }

            .impact-holder .impact-canvas img,
            .impact-holder .impact-canvas video {
                width: 100%;
                height: auto;
                display: block;
                object-fit: contain;
                margin: 0;
            }

            /* 2-Slot Side-by-Side Comparison Layout */
            .impact-split {
                display: grid;
                grid-template-columns: 1fr;
                gap: 1.25rem;
                width: 100%;
            }

            @media (min-width: 768px) {
                .impact-split {
                    grid-template-columns: 1fr 1fr;
                }
            }

            .impact-slot {
                display: flex;
                flex-direction: column;
                gap: 0.5rem;
                width: 100%;
                min-width: 0;
            }

            .slot-badge {
                font-family: var(--cs-font);
                font-size: 0.8rem;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.06em;
                color: var(--holder-text, #2a2a2a);
                opacity: 0.8;
                padding-left: 0.15rem;
            }

            .impact-canvas.placeholder-slot {
                min-height: 240px;
                border: 2px dashed var(--holder-border, rgba(0, 0, 0, 0.18));
                background: rgba(255, 255, 255, 0.65);
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                gap: 0.5rem;
                padding: 2rem 1.5rem;
                text-align: center;
                box-sizing: border-box;
            }

            .placeholder-slot .slot-hint {
                font-size: 0.95rem;
                font-weight: 500;
                color: var(--holder-text, #444);
                opacity: 0.85;
            }

            .placeholder-slot .slot-subtext {
                font-size: 0.8rem;
                color: var(--holder-text, #666);
                opacity: 0.6;
            }

            /* Comparison Grid with Top Alignment */
            .comparison-grid {
                align-items: start !important;
            }

            /* Expandable Media Canvas with Fade Mask & Toggle */
            .expandable-canvas {
                position: relative;
                max-height: 290px;
                overflow: hidden;
                display: flex !important;
                justify-content: center;
                align-items: flex-start !important;
                transition: max-height 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            }

            .expandable-canvas img {
                width: 100%;
                height: auto;
                display: block;
                object-fit: contain;
                object-position: top;
                align-self: flex-start;
                margin-top: 0;
            }

            .expandable-canvas.is-expanded {
                max-height: 12000px;
            }

            .expandable-canvas::after {
                content: "";
                position: absolute;
                bottom: 0;
                left: 0;
                right: 0;
                height: 100px;
                background: linear-gradient(
                    to bottom,
                    rgba(255, 255, 255, 0) 0%,
                    rgba(255, 255, 255, 0.9) 70%,
                    #ffffff 100%
                );
                pointer-events: none;
                opacity: 1;
                transition: opacity 0.3s ease;
            }

            .expandable-canvas.is-expanded::after {
                opacity: 0;
                pointer-events: none;
            }

            .expand-btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 0.35rem;
                margin: 0.5rem auto 0;
                padding: 0.25rem 0;
                background: none;
                border: none;
                color: #a13900;
                font-family: var(--cs-font);
                font-size: 0.95rem;
                font-weight: 500;
                cursor: pointer;
                box-shadow: none;
                transition: opacity 0.2s ease;
            }

            .expand-btn:hover {
                opacity: 0.75;
                background: none;
                border: none;
                box-shadow: none;
            }

            .expand-btn .expand-btn-text {
                text-decoration: underline;
                text-decoration-style: dotted;
                text-decoration-color: #a13900;
                text-decoration-thickness: 12.5%;
                text-underline-offset: 0.22em;
            }

            .expand-btn .expand-btn-icon {
                display: inline-block;
                width: 11px;
                height: 11px;
                color: #a13900;
                transition: transform 0.25s ease;
            }

            .expand-btn[aria-expanded="true"] .expand-btn-icon {
                transform: rotate(180deg);
            }

            /* Differentiating theme colors for image containers only */
            .theme-betterhelp,
            .impact-holder.theme-betterhelp {
                --holder-bg: #e8f0ec;
                --holder-border: #d1e1d9;
                --holder-text: #234d37;
            }
            .impact-holder.theme-betterhelp.bold {
                --holder-bg: #4e7b62;
                --holder-border: #3b6650;
                --holder-text: #ffffff;
            }

            .theme-strawberry,
            .impact-holder.theme-strawberry {
                --holder-bg: #d7eceb;
                --holder-border: #b6dcda;
                --holder-text: #1a4b4b;
            }
            .impact-holder.theme-strawberry.bold {
                --holder-bg: #4b9797;
                --holder-border: #3b7e7e;
                --holder-text: #ffffff;
            }

            .theme-strawberry-ai,
            .impact-holder.theme-strawberry-ai {
                --holder-bg: #f0edf5;
                --holder-border: #ddd6e5;
                --holder-text: #4c3c5c;
            }
            .impact-holder.theme-strawberry-ai.bold {
                --holder-bg: #756388;
                --holder-border: #5f4f70;
                --holder-text: #ffffff;
            }

            .theme-echokids,
            .impact-holder.theme-echokids {
                --holder-bg: #faf0e6;
                --holder-border: #f3dec9;
                --holder-text: #7a3b18;
            }
            .impact-holder.theme-echokids.bold {
                --holder-bg: #dd7a43;
                --holder-border: #c36330;
                --holder-text: #ffffff;
            }

            .grid-3 {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 1.5rem;
                margin: 1.5rem 0;
            }

            .grid-4 {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 1.5rem;
                margin: 1.5rem 0;
            }

            @media (min-width: 768px) {
                .grid-4 {
                    grid-template-columns: repeat(4, 1fr);
                }
            }

            .grid-card {
                background: #f8f8f8;
                border: 1px solid rgba(0, 0, 0, 0.06);
                border-radius: 8px;
                padding: clamp(1.25rem, 2.5vw, 1.75rem);
                display: flex;
                flex-direction: column;
                box-sizing: border-box;
            }

            .grid-card > :first-child {
                margin-top: 0 !important;
            }

            .grid-card h3 {
                font-family: var(--cs-font);
                font-size: 1.125rem;
                line-height: 1.4;
                font-weight: 600;
                margin-top: 0 !important;
                margin-bottom: 0.5rem;
            }

            .grid-card p {
                font-size: 1rem;
                line-height: 1.6;
                margin-bottom: 0.5rem;
            }

            .grid-card p:last-child {
                margin-bottom: 0;
            }

            .grid-card ul {
                font-size: 1rem;
                line-height: 1.6;
                padding-left: 1.25rem;
                margin-top: 0;
            }

            /* Visual Impact Metric Cards */
            .stat-card {
                background: #f8f8f8;
                border: 1px solid rgba(0, 0, 0, 0.06);
                border-radius: 8px;
                padding: clamp(1.25rem, 2.5vw, 1.75rem);
                display: flex;
                flex-direction: column;
                gap: 0.35rem;
                box-sizing: border-box;
            }

            .stat-card > :first-child {
                margin-top: 0 !important;
            }

            .stat-card-value {
                font-family: var(--cs-font-display);
                font-size: clamp(2rem, 3.5vw, 2.75rem);
                font-weight: 700;
                line-height: 1.1;
                color: #a13900;
                margin: 0;
            }

            .stat-card-label {
                font-family: var(--cs-font);
                font-size: 1.1rem;
                font-weight: 600;
                color: var(--cs-text);
                margin: 0;
                line-height: 1.35;
            }

            .stat-card-subtext {
                font-size: 0.925rem;
                color: var(--cs-text-muted);
                line-height: 1.45;
                margin: 0;
            }

            /* ================================================
               EDITORIAL REFLECTION & TAKEAWAYS
               Minimalist style without gray card backgrounds
               ================================================ */
            .reflection-grid,
            #reflection .grid-2,
            #reflection .grid-3,
            .learnings-grid {
                display: grid;
                gap: 2rem;
                margin: 2rem 0;
            }

            @media (min-width: 768px) {
                .reflection-grid.grid-2,
                #reflection .grid-2 {
                    grid-template-columns: repeat(2, 1fr);
                    gap: 3rem;
                }
                .reflection-grid.grid-3,
                #reflection .grid-3,
                .learnings-grid {
                    grid-template-columns: repeat(3, 1fr);
                    gap: 2.5rem;
                }
            }

            .reflection-item,
            #reflection .grid-card,
            .learnings-grid .grid-card {
                background: transparent !important;
                border: none !important;
                border-radius: 0 !important;
                padding: 1.5rem 0 0 0 !important;
                border-top: 1px solid var(--cs-border, rgba(0, 0, 0, 0.12)) !important;
                display: flex;
                flex-direction: column;
                gap: 0.75rem;
                box-shadow: none !important;
            }

            .reflection-num {
                font-family: var(--cs-font-display);
                font-size: 0.85rem;
                font-weight: 700;
                letter-spacing: 0.08em;
                text-transform: uppercase;
                color: #a13900;
                margin-bottom: -0.25rem;
            }

            .reflection-item h3,
            #reflection .grid-card h3,
            .learnings-grid .grid-card h3 {
                font-family: var(--cs-font-display);
                font-size: 1.25rem;
                line-height: 1.35;
                font-weight: 600;
                color: var(--cs-text);
                margin: 0;
            }

            .reflection-item p,
            #reflection .grid-card p,
            .learnings-grid .grid-card p {
                font-family: var(--cs-font);
                font-size: 1.05rem;
                line-height: 1.65;
                color: var(--cs-text);
                opacity: 0.88;
                margin: 0;
            }

            /* ================================================
               IMAGES & FIGMA EMBEDS (global resets)
               ================================================ */
            .cs-content img,
            .cs-content video {
                width: 100%;
                height: auto;
                border-radius: 0;
            }

            .figma-container {
                position: relative;
                width: 100%;
                padding-bottom: 56.25%; /* 16:9 */
                height: 0;
                margin: 1.5rem 0;
            }

            .figma-container iframe {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                border: 1px solid var(--cs-border);
                border-radius: 0;
            }

            /* ================================================
               PLACEHOLDER HIGHLIGHT
               Wrap unverified copy in <span class="todo">…</span>.
               Remove the class once the value is confirmed.
               ================================================ */
            .todo {
                background: #fff3a3;
                outline: 1px dashed #d4b200;
                padding: 0 0.15em;
                border-radius: 2px;
            }

            /* ================================================
               MOBILE RESPONSIVE OVERRIDES
               ================================================ */
            @media (max-width: 767px) {
                .cs-grid {
                    grid-template-columns: 1fr;
                    gap: 0;
                }

                .cs-sidebar {
                    position: static;
                    width: 100%;
                    height: auto;
                    padding: 3rem 0 0;
                }

                .cs-content {
                    padding: 2rem 0;
                    gap: 2rem;
                }

                .cs-hero h1 {
                    font-size: 1.75rem;
                }

                .grid-2,
                .grid-3,
                .grid-4 {
                    grid-template-columns: 1fr;
                    gap: 1rem;
                    margin: 1rem 0;
                }

                .grid-card {
                    padding: 1.15rem;
                }

                .section-divider {
                    margin: 1.75rem 0 0.85rem;
                }

                .impact-holder {
                    margin: 1.25rem 0;
                    padding: 1rem;
                }
            }

            /* ================================================
               CASE STUDY FOOTER & CTA SECTION
               ================================================ */
            .cs-footer {
                margin-top: 2rem;
                padding-top: 3.5rem;
                border-top: 1px solid var(--cs-border);
                display: flex;
                flex-direction: column;
                gap: 2.5rem;
                min-height: 80vh;
            }

            .cs-footer-grid {
                display: grid;
                grid-template-columns: 1fr;
                gap: 1.25rem;
            }

            @media (min-width: 768px) {
                .cs-footer-grid {
                    grid-template-columns: 1.15fr 0.85fr;
                    gap: 1.25rem;
                    align-items: stretch;
                }
            }

            .cs-footer-connect {
                background: #fbfbfb;
                border: 1px solid var(--cs-border);
                border-radius: 6px;
                padding: 2.25rem 2rem;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                gap: 1.5rem;
            }

            .cs-footer-connect-text h3 {
                font-size: 1.5rem;
                font-weight: 600;
                line-height: 1.3;
                margin-bottom: 0.75rem;
                letter-spacing: -0.01em;
            }

            .cs-footer-connect-text p {
                font-size: 1rem;
                line-height: 1.6;
                color: #4b5563;
                margin: 0;
            }

            .cs-footer-actions {
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                gap: 0.875rem;
                margin-top: 0.5rem;
            }

            .cs-btn-primary {
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                background: #a13900;
                color: #ffffff;
                font-size: 0.9rem;
                font-weight: 600;
                padding: 0.7rem 1.25rem;
                border-radius: 6px;
                text-decoration: none;
                border: none;
                cursor: pointer;
                font-family: inherit;
                transition:
                    transform 0.15s ease,
                    background 0.15s ease;
            }

            .cs-btn-primary:hover {
                background: #8a3000;
                transform: translateY(-1px);
            }

            .cs-btn-copy {
                display: inline-flex;
                align-items: center;
                gap: 0.45rem;
                background: #ffffff;
                color: #111111;
                border: 1px solid var(--cs-border);
                font-size: 0.9rem;
                font-weight: 500;
                padding: 0.65rem 1.1rem;
                border-radius: 6px;
                cursor: pointer;
                transition:
                    background 0.15s ease,
                    border-color 0.15s ease;
                font-family: inherit;
            }

            .cs-btn-copy:hover {
                background: #f4f4f5;
                border-color: #a1a1aa;
            }

            .cs-btn-copy svg {
                width: 15px;
                height: 15px;
                opacity: 0.7;
            }

            .cs-social-link {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 38px;
                height: 38px;
                border-radius: 6px;
                border: 1px solid var(--cs-border);
                background: #ffffff;
                color: #111111;
                text-decoration: none;
                transition:
                    border-color 0.15s ease,
                    transform 0.15s ease;
            }

            .cs-social-link:hover {
                border-color: #71717a;
                transform: translateY(-1px);
            }

            .cs-social-link svg {
                width: 17px;
                height: 17px;
            }

            /* Next Case Study Card */
            .cs-next-card {
                background: #ffffff;
                border: 1px solid var(--cs-border);
                border-radius: 6px;
                padding: 2.25rem 2rem;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                text-decoration: none;
                color: inherit;
                transition:
                    border-color 0.2s ease,
                    transform 0.2s ease,
                    box-shadow 0.2s ease;
                position: relative;
                overflow: hidden;
            }

            .cs-next-card:hover {
                border-color: #111111;
                transform: translateY(-2px);
                box-shadow: 0 10px 24px -10px rgba(0, 0, 0, 0.08);
            }

            .cs-next-card-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 0.65rem;
            }

            .cs-next-badge {
                font-size: 0.875rem;
                font-weight: 500;
                text-transform: none;
                letter-spacing: normal;
                color: #71717a;
            }

            .cs-next-arrow {
                width: 32px;
                height: 32px;
                border-radius: 4px;
                background: #f4f4f5;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.1rem;
                transition:
                    background 0.2s ease,
                    transform 0.2s ease;
            }

            .cs-next-card:hover .cs-next-arrow {
                background: #111111;
                color: #ffffff;
                transform: translateX(3px);
            }

            .cs-next-card-body h4 {
                font-size: 1.25rem;
                font-weight: 600;
                line-height: 1.35;
                margin-bottom: 0.35rem;
                letter-spacing: -0.01em;
                color: var(--cs-text);
            }

            .cs-next-card-body p {
                font-size: 0.925rem;
                line-height: 1.5;
                color: #52525b;
                margin: 0;
            }

            .cs-next-card-footer {
                margin-top: 1.5rem;
                padding-top: 1rem;
                border-top: 1px dashed var(--cs-border);
                display: flex;
                align-items: center;
                justify-content: space-between;
                font-size: 0.85rem;
                color: #71717a;
            }

            /* Bottom quick bar: all projects & back to top */
            .cs-footer-bottom {
                display: flex;
                align-items: center;
                justify-content: space-between;
                font-size: 0.875rem;
                color: #71717a;
                padding-top: 0.5rem;
            }

            .cs-footer-bottom a {
                color: var(--cs-text);
                text-decoration: none;
                font-weight: 500;
                transition: opacity 0.2s ease;
            }

            .cs-footer-bottom a:hover {
                opacity: 0.7;
            }

            /* ================================================
               PASSWORD PROTECTION GATE STYLING
               ================================================ */
            .cs-lock-gate {
                background: #ffffff;
                border: 1px solid var(--cs-border);
                border-radius: 8px;
                padding: clamp(2rem, 5vw, 3.5rem);
                margin: 2rem 0;
                text-align: center;
                box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
            }

            .cs-lock-icon {
                width: 52px;
                height: 52px;
                margin: 0 auto 1.25rem;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 50%;
                background: #a1380013;
                color: #a13900;
            }

            .cs-lock-icon svg {
                width: 24px;
                height: 24px;
                stroke-width: 2;
            }

            .cs-lock-gate h3 {
                font-size: 1.5rem;
                font-weight: 600;
                margin-bottom: 0.75rem;
                letter-spacing: -0.01em;
            }

            .cs-lock-desc {
                font-size: 1rem;
                color: #52525b;
                max-width: 440px;
                margin: 0 auto 1.75rem;
                line-height: 1.5;
            }

            .cs-lock-form {
                display: flex;
                flex-direction: column;
                gap: 0.75rem;
                max-width: 380px;
                margin: 0 auto;
            }

            .cs-lock-input-group {
                display: flex;
                gap: 0.5rem;
            }

            .cs-lock-input {
                flex: 1;
                font-family: inherit;
                font-size: 0.95rem;
                padding: 0.75rem 1rem;
                border: 1.5px solid var(--cs-border);
                border-radius: 6px;
                outline: none;
                transition:
                    border-color 0.2s ease,
                    box-shadow 0.2s ease;
                background: #fdfdfd;
            }

            .cs-lock-input:focus {
                border-color: #111111;
                box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.05);
            }

            .cs-lock-btn {
                font-family: inherit;
                font-size: 0.95rem;
                font-weight: 600;
                padding: 0.75rem 1.25rem;
                background: #111111;
                color: #ffffff;
                border: none;
                border-radius: 6px;
                cursor: pointer;
                transition:
                    background 0.2s ease,
                    transform 0.15s ease;
                white-space: nowrap;
            }

            .cs-lock-btn:hover {
                background: #27272a;
                transform: translateY(-1px);
            }

            .cs-lock-error {
                color: #dc2626;
                font-size: 0.85rem;
                font-weight: 500;
                min-height: 1.25rem;
                margin: 0;
            }

            .cs-lock-help {
                margin-top: 1.5rem;
                font-size: 0.85rem;
                color: #71717a;
            }

            .cs-lock-help a {
                color: #a13900;
                text-decoration: underline;
                text-decoration-style: dotted;
                text-decoration-color: #a13900;
                text-decoration-thickness: 12.5%;
                text-underline-offset: 0.18em;
                font-weight: 600;
            }

            .cs-protected-badge {
                display: inline-flex;
                align-items: center;
                gap: 0.35rem;
                background: #fef3c7;
                color: #92400e;
                font-size: 0.75rem;
                font-weight: 600;
                padding: 3px 8px;
                border-radius: 4px;
                margin-left: 0.5rem;
                vertical-align: middle;
            }

            /* Hide the protected content wrapper by default */
            .cs-protected-locked {
                display: none !important;
            }

            @keyframes lockShake {
                0%,
                100% {
                    transform: translateX(0);
                }
                20%,
                60% {
                    transform: translateX(-6px);
                }
                40%,
                80% {
                    transform: translateX(6px);
                }
            }

            .cs-shake {
                animation: lockShake 0.4s ease;
            }
        </style>
    </head>

    <body>
        <div class="cs-page">
            <main class="cs-grid">
                <!-- ======== SIDEBAR ======== -->
                <aside class="cs-sidebar">
                    <a href="/" class="cs-back">
                        <svg
                            focusable="false"
                            aria-hidden="true"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20z"
                                fill="currentColor"></path>
                        </svg>
                        Back
                    </a>

                    {
                        sections.length > 0 && (
                            <nav
                                class={`cs-nav ${passwordProtected ? "cs-protected-locked" : ""}`}
                                id="csSidebarNav"
                            >
                                <ul>
                                    {sections.map(
                                        (s: { id: string; label: string }) => (
                                            <li>
                                                <a
                                                    href={`#${s.id}`}
                                                    class="nav-link"
                                                >
                                                    {s.label}
                                                </a>
                                            </li>
                                        ),
                                    )}
                                </ul>
                            </nav>
                        )
                    }
                </aside>

                <!-- ======== MAIN CONTENT ======== -->
                <div class="cs-content">
                    <!-- Hero -->
                    <div class="cs-hero">
                        <div class="cs-hero-text">
                            <h4 class="cs-hero-label">
                                {title}{year && <Fragment> • {year}</Fragment>}
                            </h4>
                            <h1>{subtitle}</h1>
                        </div>

                        {
                            heroImage && (
                                <div class="cs-hero-image">
                                    {heroImage.endsWith(".mp4") ||
                                    heroImage.endsWith(".webm") ? (
                                        <video
                                            autoplay
                                            loop
                                            muted
                                            playsinline
                                            poster={heroPoster || undefined}
                                        >
                                            <source
                                                src={encodeURI(heroImage)}
                                                type={
                                                    heroImage.endsWith(".webm")
                                                        ? "video/webm"
                                                        : "video/mp4"
                                                }
                                            />
                                        </video>
                                    ) : (
                                        <img
                                            src={heroImage}
                                            alt={`Project thumbnail for ${title}`}
                                            loading="eager"
                                        />
                                    )}
                                </div>
                            )
                        }

                        {
                            (role ||
                                timeline ||
                                team.length > 0 ||
                                skills.length > 0) && (
                                <div class="cs-meta">
                                    {role && (
                                        <div class="cs-meta-item">
                                            <h4>Role</h4>
                                            <p>{role}</p>
                                        </div>
                                    )}
                                    {timeline && (
                                        <div class="cs-meta-item">
                                            <h4>Timeline</h4>
                                            <p>{timeline}</p>
                                        </div>
                                    )}
                                    {team.length > 0 && (
                                        <div class="cs-meta-item">
                                            <h4>Team</h4>
                                            <div>
                                                {team.map((t: string) => (
                                                    <p>{t}</p>
                                                ))}
                                            </div>
                                        </div>
                                    )}
                                    {skills.length > 0 && (
                                        <div class="cs-meta-item cs-meta-skills">
                                            <h4>Skills</h4>
                                            <ul class="skills-list">
                                                {skills.map((s: string) => (
                                                    <li>{s}</li>
                                                ))}
                                            </ul>
                                        </div>
                                    )}
                                </div>
                            )
                        }
                    </div>

                    {
                        passwordProtected ? (
                            <Fragment>
                                <div id="csLockGate" class="cs-lock-gate">
                                    <div
                                        class="cs-lock-icon"
                                        aria-hidden="true"
                                    >
                                        <svg
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                        >
                                            <rect
                                                x="3"
                                                y="11"
                                                width="18"
                                                height="11"
                                                rx="2"
                                                ry="2"
                                            />
                                            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                                        </svg>
                                    </div>
                                    <h3>Confidential Case Study</h3>
                                    <p class="cs-lock-desc">
                                        This project contains sensitive 0→1
                                        workflows and metrics. Please enter the
                                        password to view the full case study.
                                    </p>
                                    <form
                                        id="csLockForm"
                                        class="cs-lock-form"
                                        onsubmit="return false;"
                                    >
                                        <div class="cs-lock-input-group">
                                            <input
                                                type="password"
                                                id="csPasswordInput"
                                                class="cs-lock-input"
                                                placeholder="Enter password..."
                                                autocomplete="current-password"
                                                required
                                            />
                                            <button
                                                type="submit"
                                                id="csUnlockBtn"
                                                class="cs-lock-btn"
                                            >
                                                Unlock →
                                            </button>
                                        </div>
                                        <p
                                            id="csLockError"
                                            class="cs-lock-error"
                                            role="alert"
                                        />
                                    </form>
                                    <p class="cs-lock-help">
                                        Don't have the password?{" "}
                                        <a
                                            href="mailto:tvishapatel0@gmail.com?subject=Password%20Access%20Request:%20Strawberry.me%20AI"
                                            data-umami-event="Password Request Click"
                                            data-umami-event-location="lock-screen"
                                        >
                                            Email me for access
                                        </a>
                                    </p>
                                </div>

                                <div
                                    id="csProtectedBody"
                                    class="cs-protected-locked"
                                >
                                    <Fragment set:html="<!-- PROTECTED_CONTENT_START -->" />
                                    <slot />
                                    <Fragment set:html="<!-- PROTECTED_CONTENT_END -->" />
                                </div>
                            </Fragment>
                        ) : (
                            <slot />
                        )
                    }

                    <!-- ======== CASE STUDY FOOTER / CTA ======== -->
                    <footer class="cs-footer">
                        <div class="cs-footer-grid">
                            <!-- Left: Thanks for reading & Connect -->
                            <div class="cs-footer-connect">
                                <div class="cs-footer-connect-text">
                                    <h3>Thanks for reading!</h3>
                                    <p>
                                        I specialize in 0→1 product design,
                                        building trust into complex workflows,
                                        from two-sided marketplaces to
                                        high-reliability AI features. If you're
                                        building something ambitious, let's
                                        connect!
                                    </p>
                                </div>

                                <div class="cs-footer-actions">
                                    <button
                                        type="button"
                                        class="cs-btn-primary copy-email"
                                        data-copy="tvishapatel0@gmail.com"
                                        aria-label="Copy email address"
                                        data-umami-event="Copy Email Click"
                                        data-umami-event-location="case-study-footer"
                                    >
                                        <span>Let's Talk</span>
                                        <span aria-hidden="true">→</span>
                                    </button>

                                    <a
                                        href="https://www.linkedin.com/in/tvishapatel-10/"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="cs-social-link"
                                        aria-label="LinkedIn Profile"
                                        data-umami-event="LinkedIn Outbound Click"
                                        data-umami-event-location="case-study-footer"
                                    >
                                        <svg
                                            viewBox="0 0 24 24"
                                            fill="currentColor"
                                        >
                                            <path
                                                d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45c-.89 0-1.61.72-1.61 1.61 0 .88.72 1.6 1.61 1.6.88 0 1.6-.72 1.6-1.6 0-.89-.72-1.61-1.6-1.61Z"
                                            ></path>
                                        </svg>
                                    </a>
                                </div>
                            </div>

                            <!-- Right: Next Case Study Card -->
                            <a href={nextCaseStudy.path} class="cs-next-card">
                                <div>
                                    <div class="cs-next-card-header">
                                        <span class="cs-next-badge"
                                            >Next case study</span
                                        >
                                        <span
                                            class="cs-next-arrow"
                                            aria-hidden="true">→</span
                                        >
                                    </div>
                                    <div class="cs-next-card-body">
                                        <h4>{nextCaseStudy.title}</h4>
                                        <p>
                                            {nextCaseStudy.company} • {
                                                nextCaseStudy.tagline
                                            }
                                        </p>
                                    </div>
                                </div>

                                <div class="cs-next-card-footer">
                                    <span>{nextCaseStudy.role}</span>
                                    <span>{nextCaseStudy.year}</span>
                                </div>
                            </a>
                        </div>

                        <!-- Footer bottom navigation -->
                        <div class="cs-footer-bottom">
                            <a href="/" class="cs-back-home">
                                ← Back to homepage
                            </a>
                            <a
                                href="#"
                                class="cs-back-top"
                                onclick="window.scrollTo({top: 0, behavior: 'smooth'}); return false;"
                            >
                                Back to top ↑
                            </a>
                        </div>
                    </footer>
                </div>

                <!-- ======== RIGHT SPACER ======== -->
                <div class="cs-spacer"></div>
            </main>
        </div>

        <!-- ======== SCROLLSPY JS ======== -->
        <script>
            document.addEventListener("DOMContentLoaded", () => {
                const navLinks = Array.from(
                    document.querySelectorAll(".cs-nav .nav-link"),
                );

                if (navLinks.length === 0) return;

                let targets: Array<{ link: Element; el: HTMLElement }> = [];

                function refreshTargets() {
                    targets = navLinks
                        .map((link) => {
                            const href = link.getAttribute("href");
                            if (!href || !href.startsWith("#")) return null;
                            const id = href.slice(1);
                            const el = document.getElementById(id);
                            return el ? { link, el } : null;
                        })
                        .filter(
                            (
                                item,
                            ): item is { link: Element; el: HTMLElement } =>
                                item !== null,
                        );
                }

                refreshTargets();

                function updateActiveLink() {
                    if (targets.length === 0) {
                        refreshTargets();
                    }
                    if (targets.length === 0) return;

                    const scrollPosition = window.scrollY;
                    const windowHeight = window.innerHeight;
                    const documentHeight =
                        document.documentElement.scrollHeight;

                    // If user is at or near the bottom of the page, activate the last section
                    if (windowHeight + scrollPosition >= documentHeight - 60) {
                        setActive(targets[targets.length - 1].link);
                        return;
                    }

                    // A section is active when its top is at or above the threshold
                    // (25% down the viewport, or at least 100px)
                    const threshold = Math.max(100, windowHeight * 0.25);

                    let currentTarget = targets[0];
                    for (let i = 0; i < targets.length; i++) {
                        const rect = targets[i].el.getBoundingClientRect();
                        if (rect.top <= threshold) {
                            currentTarget = targets[i];
                        } else {
                            break;
                        }
                    }

                    setActive(currentTarget.link);
                }

                function setActive(activeLink: Element) {
                    navLinks.forEach((link) => {
                        if (link === activeLink) {
                            link.classList.add("active");
                        } else {
                            link.classList.remove("active");
                        }
                    });
                }

                // Initial calculation on page load
                updateActiveLink();

                // Smooth update on scroll using requestAnimationFrame
                let ticking = false;
                window.addEventListener(
                    "scroll",
                    () => {
                        if (!ticking) {
                            window.requestAnimationFrame(() => {
                                updateActiveLink();
                                ticking = false;
                            });
                            ticking = true;
                        }
                    },
                    { passive: true },
                );

                // Update on window resize
                window.addEventListener("resize", updateActiveLink, {
                    passive: true,
                });

                // Sidebar navigation click
                navLinks.forEach((link) => {
                    link.addEventListener("click", (e) => {
                        const href = link.getAttribute("href");
                        if (!href || !href.startsWith("#")) return;
                        const targetId = href.slice(1);
                        const targetEl = document.getElementById(targetId);
                        if (!targetEl) return;

                        e.preventDefault();
                        setActive(link);

                        if (history.pushState) {
                            history.pushState(null, "", href);
                        } else {
                            window.location.hash = href;
                        }

                        targetEl.scrollIntoView({
                            behavior: "smooth",
                            block: "start",
                        });
                    });
                });

                // Copy email functionality
                const copyBtn = document.getElementById("csCopyEmailBtn");
                if (copyBtn) {
                    copyBtn.addEventListener("click", async () => {
                        const email =
                            copyBtn.getAttribute("data-email") ||
                            "tvishapatel0@gmail.com";
                        try {
                            await navigator.clipboard.writeText(email);
                        } catch (err) {
                            const textarea = document.createElement("textarea");
                            textarea.value = email;
                            textarea.style.position = "fixed";
                            textarea.style.opacity = "0";
                            document.body.appendChild(textarea);
                            textarea.select();
                            document.execCommand("copy");
                            document.body.removeChild(textarea);
                        }
                    });
                }

                // Expandable comparison canvases
                document.querySelectorAll(".expand-btn").forEach((btn) => {
                    btn.addEventListener("click", () => {
                        const targetId = btn.getAttribute("aria-controls");
                        const canvas = targetId
                            ? document.getElementById(targetId)
                            : btn
                                  .closest(".impact-holder")
                                  ?.querySelector(".expandable-canvas");
                        if (!canvas) return;

                        const isExpanded =
                            canvas.classList.toggle("is-expanded");
                        btn.setAttribute("aria-expanded", String(isExpanded));
                        const textSpan = btn.querySelector(".expand-btn-text");
                        if (textSpan) {
                            textSpan.textContent = isExpanded
                                ? "Show less"
                                : "See full page";
                        }

                        // Scroll back into view if collapsing from below
                        if (!isExpanded) {
                            const rect = canvas.getBoundingClientRect();
                            if (rect.top < 80) {
                                canvas.scrollIntoView({
                                    behavior: "smooth",
                                    block: "start",
                                });
                            }
                        }
                    });
                });

                // ================================================
                // PASSWORD PROTECTION DECRYPTION PIPELINE
                // ================================================
                const lockGate = document.getElementById("csLockGate");
                const lockForm = document.getElementById("csLockForm");
                const passwordInput = document.getElementById(
                    "csPasswordInput",
                ) as HTMLInputElement | null;
                const lockError = document.getElementById("csLockError");
                const unlockBtn = document.getElementById("csUnlockBtn");
                const encryptedPayloadEl =
                    document.getElementById("csEncryptedPayload");
                const protectedSlot = document.getElementById(
                    "csProtectedContentSlot",
                );
                const protectedBody =
                    document.getElementById("csProtectedBody");

                if (lockGate) {
                    const payloadRaw = encryptedPayloadEl
                        ? encryptedPayloadEl.getAttribute("data-payload")
                        : null;

                    async function handleUnlock(
                        password: string,
                        shouldScrollToTop: boolean = false,
                    ) {
                        // 1. Production Mode: Encrypted Payload exists
                        if (payloadRaw && protectedSlot) {
                            try {
                                const payload = JSON.parse(payloadRaw);
                                const enc = new TextEncoder();
                                const passwordKey =
                                    await window.crypto.subtle.importKey(
                                        "raw",
                                        enc.encode(password),
                                        "PBKDF2",
                                        false,
                                        ["deriveKey"],
                                    );

                                const salt = Uint8Array.from(
                                    atob(payload.salt),
                                    (c) => c.charCodeAt(0),
                                );
                                const iv = Uint8Array.from(
                                    atob(payload.iv),
                                    (c) => c.charCodeAt(0),
                                );
                                const tag = Uint8Array.from(
                                    atob(payload.tag),
                                    (c) => c.charCodeAt(0),
                                );
                                const encryptedData = Uint8Array.from(
                                    atob(payload.data),
                                    (c) => c.charCodeAt(0),
                                );

                                const combined = new Uint8Array(
                                    encryptedData.length + tag.length,
                                );
                                combined.set(encryptedData, 0);
                                combined.set(tag, encryptedData.length);

                                const aesKey =
                                    await window.crypto.subtle.deriveKey(
                                        {
                                            name: "PBKDF2",
                                            salt: salt,
                                            iterations: 100000,
                                            hash: "SHA-256",
                                        },
                                        passwordKey,
                                        { name: "AES-GCM", length: 256 },
                                        false,
                                        ["decrypt"],
                                    );

                                const decrypted =
                                    await window.crypto.subtle.decrypt(
                                        { name: "AES-GCM", iv: iv },
                                        aesKey,
                                        combined,
                                    );

                                const dec = new TextDecoder();
                                protectedSlot.innerHTML = dec.decode(decrypted);
                                protectedSlot.style.display = "block";
                                if (protectedBody) {
                                    protectedBody.classList.remove(
                                        "cs-protected-locked",
                                    );
                                    protectedBody.style.display = "block";
                                }
                                const innerBody =
                                    protectedSlot.querySelector(
                                        "#csProtectedBody",
                                    );
                                if (innerBody) {
                                    innerBody.classList.remove(
                                        "cs-protected-locked",
                                    );
                                    (innerBody as HTMLElement).style.display =
                                        "block";
                                }
                                lockGate.style.display = "none";
                                const sidebarNav =
                                    document.getElementById("csSidebarNav");
                                if (sidebarNav)
                                    sidebarNav.classList.remove(
                                        "cs-protected-locked",
                                    );
                                sessionStorage.setItem(
                                    "cs_unlocked_session",
                                    password,
                                );

                                if (shouldScrollToTop) {
                                    window.scrollTo({
                                        top: 0,
                                        behavior: "instant" as ScrollBehavior,
                                    });
                                }

                                setTimeout(() => {
                                    if (shouldScrollToTop) {
                                        window.scrollTo({
                                            top: 0,
                                            behavior:
                                                "instant" as ScrollBehavior,
                                        });
                                    }
                                    refreshTargets();
                                    updateActiveLink();
                                }, 50);

                                return true;
                            } catch (err) {
                                return false;
                            }
                        }

                        // 2. Dev Mode Fallback: Content is hidden via cs-protected-locked class
                        if (protectedBody) {
                            if (password.toLowerCase() === "peek-a-boo") {
                                protectedBody.classList.remove(
                                    "cs-protected-locked",
                                );
                                lockGate.style.display = "none";
                                const sidebarNav =
                                    document.getElementById("csSidebarNav");
                                if (sidebarNav)
                                    sidebarNav.classList.remove(
                                        "cs-protected-locked",
                                    );
                                sessionStorage.setItem(
                                    "cs_unlocked_session",
                                    password,
                                );

                                if (shouldScrollToTop) {
                                    window.scrollTo({
                                        top: 0,
                                        behavior: "instant" as ScrollBehavior,
                                    });
                                }

                                setTimeout(() => {
                                    if (shouldScrollToTop) {
                                        window.scrollTo({
                                            top: 0,
                                            behavior:
                                                "instant" as ScrollBehavior,
                                        });
                                    }
                                    refreshTargets();
                                    updateActiveLink();
                                }, 50);

                                return true;
                            }
                            return false;
                        }

                        return false;
                    }

                    // Check if already unlocked in this browser session
                    const savedPassword = sessionStorage.getItem(
                        "cs_unlocked_session",
                    );
                    if (savedPassword) {
                        handleUnlock(savedPassword, false);
                    }

                    if (lockForm && passwordInput) {
                        lockForm.addEventListener("submit", async (e) => {
                            e.preventDefault();
                            const pass = passwordInput.value.trim();
                            if (!pass) return;

                            if (lockError) lockError.textContent = "";
                            if (unlockBtn)
                                unlockBtn.textContent = "Unlocking...";

                            const success = await handleUnlock(pass, true);
                            if (unlockBtn) unlockBtn.textContent = "Unlock →";

                            if (!success) {
                                if (lockError)
                                    lockError.textContent =
                                        "Incorrect password. Please try again.";
                                lockGate.classList.remove("cs-shake");
                                void lockGate.offsetWidth; // Trigger reflow for shake animation
                                lockGate.classList.add("cs-shake");
                                passwordInput.focus();
                                passwordInput.select();
                            }
                        });
                    }
                }
            });
        </script>
        <CustomCursor />
    </body>
</html>
