---
// src/layouts/CaseStudyLayout.astro
const { frontmatter } = Astro.props;

// Destructure frontmatter with defaults
const {
    title = "",
    year = "",
    subtitle = "",
    heroImage = "",
    heroPoster = "",
    role = "",
    timeline = "",
    team = [],
    skills = [],
    sections = [],
    passwordProtected = false,
    description = "",
} = frontmatter;

// Fallback SEO description and title
const pageTitle = frontmatter.pageTitle || `${title} — Tvisha Patel`;
const metaDescription =
    description ||
    subtitle ||
    `${title} case study by Tvisha Patel, Product Designer.`;

// All case studies in viewing order
const allCaseStudies = [
    {
        title: "Strawberry.me",
        slug: "strawberry",
        role: "Founding Product Designer",
        tagline: "0→1 design for AI-assisted coaching platform | $30M+ ARR",
        year: "2024-present",
        path: "/case-studies/strawberry",
    },
    {
        title: "Strawberry.me AI",
        slug: "strawberry-ai",
        role: "Founding Product Designer",
        tagline:
            "AI message draft workflow for coaches | 60% → 92% follow-up rate",
        year: "2025",
        path: "/case-studies/strawberry-ai",
    },
    {
        title: "BetterHelp",
        slug: "betterhelp",
        role: "Product Design Intern",
        tagline:
            "Simplifying technical complexity for clients and therapists | 33% more streamlined flow",
        year: "2023",
        path: "/case-studies/betterhelp",
    },
    {
        title: "EchoKids",
        slug: "echokids",
        role: "Product Design Intern",
        tagline:
            "How I increased retention by 200% with a 47% more effective dashboard",
        year: "2022",
        path: "/case-studies/echokids",
    },
];

// Determine current study and next/prev
const currentPath = Astro.url.pathname.replace(/\/$/, "");
const currentIndex = allCaseStudies.findIndex((cs) =>
    currentPath.endsWith(cs.slug),
);
const safeIndex = currentIndex !== -1 ? currentIndex : 0;
const nextCaseStudy = allCaseStudies[(safeIndex + 1) % allCaseStudies.length];
const prevCaseStudy =
    allCaseStudies[
        (safeIndex - 1 + allCaseStudies.length) % allCaseStudies.length
    ];

const canonicalURL = new URL(
    Astro.url.pathname,
    Astro.site || "https://tvishapatel.com",
);
const ogImage =
    heroPoster ||
    (heroImage && !heroImage.endsWith(".mp4") && !heroImage.endsWith(".webm")
        ? heroImage
        : "/images/og-image.png");
const imageURL = new URL(ogImage, Astro.site || "https://tvishapatel.com");
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{pageTitle}</title>
        <meta name="description" content={metaDescription} />
        <link rel="canonical" href={canonicalURL} />
        <link rel="icon" href="/portfolio-favicon.webp" />

        <!-- Open Graph / Facebook / LinkedIn -->
        <meta property="og:type" content="article" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={metaDescription} />
        <meta property="og:image" content={imageURL} />

        <!-- Twitter / X -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:url" content={canonicalURL} />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={metaDescription} />
        <meta name="twitter:image" content={imageURL} />

        <style is:global>
            /* --- Google Fonts (matches rest of site) --- */
            @import url("https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300..900;1,300..900&family=Geom:ital,wght@0,300..900;1,300..900&display=swap");

            /* --- DESIGN TOKENS (customize these) --- */
            :root {
                --cs-bg: #ffffff;
                --cs-text: #1a1a1a;
                --cs-text-muted: #71717a;
                --cs-border: rgba(0, 0, 0, 0.1);
                --cs-accent: #6366f1;
                --cs-callout-border: #b0b0b0;
                --cs-font-display: "Geom", sans-serif;
                --cs-font: "Figtree", sans-serif;
            }

            /* --- RESET --- */
            *,
            *::before,
            *::after {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            html {
                scroll-behavior: smooth;
            }

            body {
                font-family: var(--cs-font);
                background-color: var(--cs-bg);
                color: var(--cs-text);
                line-height: 1.6;
            }

            h1,
            h2,
            h3,
            h4 {
                font-family: var(--cs-font-display);
            }

            /* ================================================
               MASTER 3-COLUMN GRID
               sidebar (auto) | content (auto) | spacer (1fr)
               ================================================ */
            .cs-page {
                min-height: 100vh;
                padding: 0 1.5rem;
            }

            .cs-grid {
                display: grid;
                max-width: 1800px;
                margin: 0 auto;
                grid-template-columns: 1fr;
                gap: 0;
            }

            @media (min-width: 768px) {
                .cs-grid {
                    grid-template-columns: auto auto 1fr;
                    gap: 2rem;
                }
            }

            /* ================================================
               STICKY SIDEBAR
               ================================================ */
            .cs-sidebar {
                padding: 3rem 0 0;
                min-width: 160px;
            }

            @media (min-width: 768px) {
                .cs-sidebar {
                    position: sticky;
                    top: 0;
                    height: fit-content;
                    padding: 3rem 0;
                }
            }

            /* Back link */
            .cs-back {
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                color: var(--cs-text);
                text-decoration: none;
                font-size: 0.875rem;
                font-weight: 500;
                opacity: 0.5;
                transition: opacity 0.2s ease;
            }

            .cs-back:hover {
                opacity: 1;
            }

            .cs-back svg {
                width: 18px;
                height: 18px;
            }

            /* Scrollspy navigation */
            .cs-nav {
                margin-top: 2rem;
                display: none;
            }

            @media (min-width: 768px) {
                .cs-nav {
                    display: block;
                }
            }

            .cs-nav ul {
                list-style: none;
                display: flex;
                flex-direction: column;
                align-items: flex-start;
                gap: 0.5rem;
            }

            .cs-nav a {
                color: var(--cs-text);
                text-decoration: none;
                font-size: 0.875rem;
                opacity: 0.5;
                transition:
                    color 0.2s ease,
                    opacity 0.2s ease;
                cursor: pointer;
                text-align: left;
            }

            .cs-nav a:hover {
                opacity: 1;
                color: var(--cs-text);
            }

            .cs-nav a.active {
                opacity: 1;
                color: var(--cs-text);
            }

            /* ================================================
               MAIN CONTENT COLUMN
               ================================================ */
            .cs-content {
                width: 100%;
                max-width: 896px;
                padding: 3rem 0;
                display: flex;
                flex-direction: column;
                gap: 3rem;
            }

            @media (min-width: 768px) {
                .cs-content {
                    gap: 6rem;
                }
            }

            @media (min-width: 1024px) {
                .cs-content {
                    max-width: 1024px;
                }
            }

            /* Right spacer (empty, for visual balance) */
            .cs-spacer {
                display: none;
            }

            @media (min-width: 768px) {
                .cs-spacer {
                    display: block;
                    padding: 3rem 0;
                }
            }

            /* ================================================
               HERO SECTION
               ================================================ */
            .cs-hero {
                display: flex;
                flex-direction: column;
                gap: 2rem;
            }

            .cs-hero-text {
                display: flex;
                flex-direction: column;
                gap: 1rem;
            }

            /* "ProjectName • Year" label */
            .cs-hero-label {
                font-size: 0.875rem;
                font-weight: 500;
                line-height: 1.4;
                color: var(--cs-text);
            }

            /* Main heading (subtitle field) */
            .cs-hero h1 {
                font-size: 2.25rem;
                line-height: 1.15;
                font-weight: 600;
                letter-spacing: -0.01em;
            }

            /* Hero image */
            .cs-hero-image {
                width: 100%;
                aspect-ratio: 2640 / 1338;
                border: 1px solid var(--cs-border);
                border-radius: 6px;
                overflow: hidden;
            }

            .cs-hero-image img,
            .cs-hero-image video {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
                margin: 0;
                border-radius: 0;
            }

            /* 4-column metadata row */
            .cs-meta {
                display: flex;
                flex-direction: column;
                gap: 1.5rem;
            }

            @media (min-width: 768px) {
                .cs-meta {
                    flex-direction: row;
                    gap: 3rem;
                }
            }

            .cs-meta-item {
                display: flex;
                flex-direction: column;
                gap: 0.5rem;
                flex: 1;
            }

            .cs-meta-item h4 {
                font-size: 0.875rem;
                font-weight: 600;
                line-height: 1.4;
                opacity: 1;
            }

            .cs-meta-item p {
                font-size: 1rem;
                line-height: 1.6;
                margin: 0;
            }

            /* ================================================
               SECTION STRUCTURE
               ================================================ */
            .cs-section {
                display: flex;
                flex-direction: column;
                gap: 1rem;
                scroll-margin-top: 3rem;
            }

            /* Section label (h4 — "Overview", "Market Research", etc.) */
            .section-label {
                font-size: 1.125rem;
                font-weight: 600;
                line-height: 1.4;
                margin-bottom: 0.25rem;
            }

            /* Section heading (h2) */
            .cs-section h2 {
                font-size: 2rem;
                line-height: 1.3;
                font-weight: 600;
                margin-bottom: -0.5rem;
            }

            /* Sub-heading (h3) */
            .cs-section h3 {
                font-size: 1.25rem;
                line-height: 1.4;
                font-weight: 600;
            }

            /* Body text */
            .cs-section p {
                font-size: 1.125rem;
                line-height: 1.6;
            }

            .cs-section ul,
            .cs-section ol {
                padding-left: 1.5rem;
                display: flex;
                flex-direction: column;
                gap: 0.5rem;
                font-size: 1.125rem;
                line-height: 1.6;
            }

            .cs-section li {
                margin: 0;
            }

            .cs-section a {
                color: var(--cs-text);
                text-decoration: underline;
                text-underline-offset: 3px;
                transition: opacity 0.2s ease;
            }

            .cs-section a:hover {
                opacity: 0.7;
            }

            .cs-section code {
                font-family: monospace;
                background-color: #f3f4f6;
                padding: 0.15rem 0.4rem;
                border-radius: 4px;
                font-size: 0.9em;
            }

            /* Section divider */
            .section-divider {
                height: 1px;
                width: 100%;
                background-color: var(--cs-border);
                margin: 4rem 0 2rem;
            }

            /* ================================================
               UTILITY: MEDIA WITH SIDE CAPTION
               60% media | 40% caption on desktop, stacked on mobile
               ================================================ */
            .media-with-caption {
                width: 100%;
                display: flex;
                gap: 1.5rem;
                align-items: center;
                margin: 1rem 0;
            }

            .media-with-caption .media-content {
                display: grid;
                grid-template-columns: 1fr;
                gap: 2rem;
                width: 100%;
            }

            @media (min-width: 768px) {
                .media-with-caption .media-content {
                    grid-template-columns: 60% auto;
                    align-items: end;
                }
            }

            .media-with-caption .media-visual {
                width: 100%;
                border: 1px solid var(--cs-border);
                overflow: hidden;
            }

            .media-with-caption .media-visual img,
            .media-with-caption .media-visual video {
                width: 100%;
                height: auto;
                object-fit: cover;
                display: block;
                margin: 0;
                border-radius: 0;
            }

            .media-with-caption .media-caption {
                display: flex;
                flex-direction: column;
                height: fit-content;
            }

            .media-with-caption .media-caption h3 {
                font-size: 0.875rem;
                line-height: 1.4;
                margin-top: 0.5rem;
            }

            /* Mobile: show caption above media */
            .media-caption-mobile {
                display: block;
                padding-bottom: 1.5rem;
            }

            .media-caption-desktop {
                display: none;
            }

            @media (min-width: 768px) {
                .media-caption-mobile {
                    display: none;
                }

                .media-caption-desktop {
                    display: block;
                }
            }

            /* ================================================
               UTILITY: FULL-WIDTH MEDIA
               ================================================ */
            .full-width-media {
                width: 100%;
            }

            .full-width-media img,
            .full-width-media video {
                width: 100%;
                height: auto;
                object-fit: contain;
                display: block;
                margin: 0;
                border-radius: 0;
            }

            /* ================================================
               UTILITY: CALLOUT / BLOCKQUOTE
               ================================================ */
            .callout {
                font-style: italic;
                padding: 0;
                margin: 1.5rem 0;
                padding-left: 1rem;
                border-left: 2px solid var(--cs-callout-border);
            }

            .callout h3 {
                font-size: 1.125rem;
                line-height: 1.4;
                font-weight: 600;
            }

            /* ================================================
               UTILITY: MULTI-COLUMN CARDS
               (Pain Points, Reflections, etc.)
               ================================================ */
            .column-cards {
                display: flex;
                flex-direction: column;
                gap: 1.5rem;
                width: 100%;
                margin-top: 0.5rem;
            }

            @media (min-width: 768px) {
                .column-cards {
                    flex-direction: row;
                }
            }

            .column-card {
                display: flex;
                flex-direction: column;
                gap: 0.25rem;
                flex: 1;
            }

            .column-card h3 {
                font-size: 1.125rem;
                line-height: 1.4;
                font-weight: 600;
            }

            .column-card p {
                font-size: 1rem;
                line-height: 1.6;
            }

            /* ================================================
               UTILITY GRIDS
               ================================================ */
            .grid-2 {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 2rem;
                margin: 1.5rem 0;
            }

            .eval-list {
                list-style: none;
                padding: 0;
                margin: 0;
                display: flex;
                flex-direction: column;
                justify-content: center;
                gap: 1.25rem;
                align-self: center;
            }

            .eval-item {
                display: flex;
                align-items: flex-start;
                gap: 0.875rem;
                font-size: 1.05rem;
                line-height: 1.5;
                color: var(--cs-text);
            }

            .eval-icon {
                flex-shrink: 0;
                width: 22px;
                height: 22px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                margin-top: 1px;
            }

            .eval-icon svg {
                width: 20px;
                height: 20px;
                stroke-width: 2.25;
            }

            .eval-icon.eval-con {
                color: #e5534b;
            }

            .eval-icon.eval-pro {
                color: #38a169;
            }

            .eval-icon.eval-neutral {
                color: #e2941b;
            }

            /* ================================================
               IMPACT HOLDER COMPONENT (Image/Video container with label)
               ================================================ */
            .impact-holder {
                width: 100%;
                border-radius: 12px;
                padding: clamp(1.25rem, 3vw, 2.25rem);
                display: flex;
                flex-direction: column;
                gap: 1rem;
                margin: 2rem 0;
                box-sizing: border-box;
                background: var(--holder-bg, #f4f3f0);
                border: 1px solid var(--holder-border, rgba(0, 0, 0, 0.07));
            }

            .impact-holder.size-b {
                margin: 0;
                padding: clamp(0.85rem, 2vw, 1.35rem);
                gap: 0.75rem;
                border-radius: 10px;
            }

            .impact-holder .impact-label {
                font-family: var(--cs-font);
                font-size: clamp(0.95rem, 1.2vw, 1.05rem);
                font-weight: 500;
                letter-spacing: -0.01em;
                color: var(--holder-text, #2a2a2a);
                margin: 0;
                line-height: 1.35;
            }

            .impact-holder .impact-canvas {
                width: 100%;
                display: flex;
                justify-content: center;
                align-items: center;
                border-radius: 8px;
                overflow: hidden;
                background: #ffffff;
                border: 1px solid rgba(0, 0, 0, 0.06);
            }

            .impact-holder .impact-canvas img,
            .impact-holder .impact-canvas video {
                width: 100%;
                height: auto;
                display: block;
                object-fit: contain;
                margin: 0;
            }

            /* Theme classes */
            .theme-betterhelp,
            .impact-holder.theme-betterhelp {
                --holder-bg: #e8f0ec;
                --holder-border: #d1e1d9;
                --holder-text: #234d37;
            }
            .impact-holder.theme-betterhelp.bold {
                --holder-bg: #4e7b62;
                --holder-border: #3b6650;
                --holder-text: #ffffff;
            }

            .theme-strawberry,
            .impact-holder.theme-strawberry {
                --holder-bg: #d7eceb;
                --holder-border: #b6dcda;
                --holder-text: #1a4b4b;
            }
            .impact-holder.theme-strawberry.bold {
                --holder-bg: #4b9797;
                --holder-border: #3b7e7e;
                --holder-text: #ffffff;
            }

            .theme-strawberry-ai,
            .impact-holder.theme-strawberry-ai {
                --holder-bg: #f0edf5;
                --holder-border: #ddd6e5;
                --holder-text: #4c3c5c;
            }
            .impact-holder.theme-strawberry-ai.bold {
                --holder-bg: #756388;
                --holder-border: #5f4f70;
                --holder-text: #ffffff;
            }

            .theme-echokids,
            .impact-holder.theme-echokids {
                --holder-bg: #faf0e6;
                --holder-border: #f3dec9;
                --holder-text: #7a3b18;
            }
            .impact-holder.theme-echokids.bold {
                --holder-bg: #dd7a43;
                --holder-border: #c36330;
                --holder-text: #ffffff;
            }

            .grid-3 {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 1.5rem;
                margin: 1.5rem 0;
            }

            .grid-4 {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 1.5rem;
                margin: 1.5rem 0;
            }

            @media (min-width: 768px) {
                .grid-4 {
                    grid-template-columns: repeat(4, 1fr);
                }
            }

            .grid-card {
                background: #f8f8f8;
                padding: 1.5rem;
                border-radius: 4px;
            }

            .grid-card h3 {
                font-size: 1.125rem;
                line-height: 1.4;
                font-weight: 600;
                margin-bottom: 0.5rem;
            }

            .grid-card p {
                font-size: 1rem;
                line-height: 1.6;
                margin-bottom: 0.5rem;
            }

            .grid-card p:last-child {
                margin-bottom: 0;
            }

            .grid-card ul {
                font-size: 1rem;
                line-height: 1.6;
                padding-left: 1.25rem;
            }

            /* ================================================
               IMAGES & FIGMA EMBEDS (global resets)
               ================================================ */
            .cs-content img,
            .cs-content video {
                width: 100%;
                height: auto;
                border-radius: 0;
            }

            .figma-container {
                position: relative;
                width: 100%;
                padding-bottom: 56.25%; /* 16:9 */
                height: 0;
                margin: 1.5rem 0;
            }

            .figma-container iframe {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                border: 1px solid var(--cs-border);
                border-radius: 0;
            }

            /* ================================================
               PLACEHOLDER HIGHLIGHT
               Wrap unverified copy in <span class="todo">…</span>.
               Remove the class once the value is confirmed.
               ================================================ */
            .todo {
                background: #fff3a3;
                outline: 1px dashed #d4b200;
                padding: 0 0.15em;
                border-radius: 2px;
            }

            /* ================================================
               MOBILE RESPONSIVE OVERRIDES
               ================================================ */
            @media (max-width: 767px) {
                .cs-grid {
                    grid-template-columns: 1fr;
                    gap: 0;
                }

                .cs-sidebar {
                    position: static;
                    width: 100%;
                    height: auto;
                    padding: 3rem 0 0;
                }

                .cs-content {
                    padding: 3rem 0;
                }

                .cs-hero h1 {
                    font-size: 1.75rem;
                }

                .grid-2,
                .grid-3 {
                    grid-template-columns: 1fr;
                }
            }

            /* ================================================
               CASE STUDY FOOTER & CTA SECTION
               ================================================ */
            .cs-footer {
                margin-top: 2rem;
                padding-top: 3.5rem;
                border-top: 1px solid var(--cs-border);
                display: flex;
                flex-direction: column;
                gap: 2.5rem;
            }

            .cs-footer-grid {
                display: grid;
                grid-template-columns: 1fr;
                gap: 2rem;
            }

            @media (min-width: 768px) {
                .cs-footer-grid {
                    grid-template-columns: 1.15fr 0.85fr;
                    gap: 2.5rem;
                    align-items: stretch;
                }
            }

            .cs-footer-connect {
                background: #fbfbfb;
                border: 1px solid var(--cs-border);
                border-radius: 6px;
                padding: 2.25rem 2rem;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                gap: 1.5rem;
            }

            .cs-footer-connect-text h3 {
                font-size: 1.5rem;
                font-weight: 600;
                line-height: 1.3;
                margin-bottom: 0.75rem;
                letter-spacing: -0.01em;
            }

            .cs-footer-connect-text p {
                font-size: 1rem;
                line-height: 1.6;
                color: #4b5563;
                margin: 0;
            }

            .cs-footer-actions {
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                gap: 0.875rem;
                margin-top: 0.5rem;
            }

            .cs-btn-primary {
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                background: #111111;
                color: #ffffff;
                font-size: 0.9rem;
                font-weight: 600;
                padding: 0.7rem 1.25rem;
                border-radius: 6px;
                text-decoration: none;
                transition:
                    transform 0.15s ease,
                    background 0.15s ease;
            }

            .cs-btn-primary:hover {
                background: #27272a;
                transform: translateY(-1px);
            }

            .cs-btn-copy {
                display: inline-flex;
                align-items: center;
                gap: 0.45rem;
                background: #ffffff;
                color: #111111;
                border: 1px solid var(--cs-border);
                font-size: 0.9rem;
                font-weight: 500;
                padding: 0.65rem 1.1rem;
                border-radius: 6px;
                cursor: pointer;
                transition:
                    background 0.15s ease,
                    border-color 0.15s ease;
                font-family: inherit;
            }

            .cs-btn-copy:hover {
                background: #f4f4f5;
                border-color: #a1a1aa;
            }

