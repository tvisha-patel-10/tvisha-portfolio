---
// src/components/SiteFooter.astro
// Reusable, self-contained site-wide footer with branding, nav links, social icons, and email copy
interface Props {
    class?: string;
}

const { class: className = "" } = Astro.props;
---

<footer class:list={["site-footer", className]}>
    <div class="wrap footer-container">
        <div class="footer-col-brand">
            <div class="footer-brand-title">
                <span class="footer-name">TVISHA PATEL</span>
                <img
                    class="footer-illustration"
                    src="/images/computer-image-light.svg"
                    alt=""
                />
            </div>
            <p class="footer-tagline">
                designed & coded by me <span class="footer-heart">{"<3"}</span>
            </p>
        </div>

        <nav class="footer-col-nav" aria-label="Footer navigation">
            <a href="/">Work</a>
            <a href="/about">About</a>
            <button
                type="button"
                class="footer-nav-btn copy-email"
                data-copy="tvishapatel0@gmail.com"
                aria-label="Copy email address"
                data-umami-event="Copy Email Click"
                data-umami-event-location="footer-nav"
            >
                Contact
            </button>
        </nav>

        <div class="footer-social-icons">
            <a
                href="https://www.linkedin.com/in/tvishapatel-10/"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="LinkedIn"
                class="footer-icon-link"
                data-umami-event="LinkedIn Outbound Click"
                data-umami-event-location="footer"
            >
                <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                >
                    <path
                        d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45c-.89 0-1.61.72-1.61 1.61 0 .88.72 1.6 1.61 1.6.88 0 1.6-.72 1.6-1.6 0-.89-.72-1.61-1.6-1.61Z"
                    ></path>
                </svg>
            </a>
            <a
                href="https://github.com/tvisha-patel-10"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="GitHub"
                class="footer-icon-link"
                data-umami-event="GitHub Outbound Click"
                data-umami-event-location="footer"
            >
                <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                >
                    <path
                        fill-rule="evenodd"
                        clip-rule="evenodd"
                        d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z"
                    ></path>
                </svg>
            </a>
            <button
                type="button"
                class="footer-icon-link copy-email"
                data-copy="tvishapatel0@gmail.com"
                aria-label="Copy email address"
                data-umami-event="Copy Email Click"
                data-umami-event-location="footer-icon"
            >
                <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                >
                    <path
                        d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z"
                    ></path>
                </svg>
            </button>
        </div>
    </div>
</footer>

<style>
    .site-footer {
        background: #a13900;
        color: #fefdfb;
        padding: clamp(2rem, 4vw, 2.75rem) 0;
        width: 100%;
        margin-top: auto;
    }

    .footer-container {
        width: min(82.5625rem, calc(100% - 3rem));
        margin-inline: auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        flex-wrap: wrap;
    }

    .footer-col-brand {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .footer-brand-title {
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .footer-name {
        font-family: "Geom", sans-serif;
        font-size: 1.25rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        color: #fefdfb;
        line-height: 1;
    }

    .footer-illustration {
        width: 22px;
        height: 22px;
        object-fit: contain;
        display: inline-block;
    }

    .footer-tagline {
        font-size: 0.85rem;
        font-weight: 400;
        color: rgba(254, 253, 251, 0.82);
        letter-spacing: 0.01em;
        margin: 0;
    }

    .footer-heart {
        font-family: "Geom", monospace;
    }

    .footer-col-nav {
        display: flex;
        align-items: center;
        gap: clamp(1.25rem, 2.5vw, 2.5rem);
    }

    .footer-col-nav a,
    .footer-col-nav button {
        font-size: 0.95rem;
        font-weight: 500;
        color: #fefdfb;
        opacity: 0.65;
        background: none;
        border: none;
        padding: 0;
        font-family: inherit;
        cursor: pointer;
        text-decoration: none;
        transition: opacity 0.2s ease, color 0.2s ease;
    }

    .footer-col-nav a:hover,
    .footer-col-nav button:hover {
        opacity: 1;
        color: #fefdfb;
    }

    .footer-social-icons {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .footer-icon-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        border: 1px solid rgba(254, 253, 251, 0.3);
        color: #fefdfb;
        background: transparent;
        cursor: pointer;
        text-decoration: none;
        transition: border-color 0.2s ease, background 0.2s ease, opacity 0.2s ease;
    }

    .footer-icon-link:hover {
        border-color: rgba(254, 253, 251, 0.8);
        background: rgba(254, 253, 251, 0.12);
    }

    @media (max-width: 640px) {
        .footer-container {
            flex-direction: column;
            align-items: center;
            text-align: center;
            gap: 1.5rem;
        }

        .footer-col-brand {
            align-items: center;
        }
    }
</style>

<script>
    document.querySelectorAll(".site-footer [data-copy]").forEach((btn) => {
        btn.addEventListener("click", async () => {
            const email = btn.getAttribute("data-copy") || "tvishapatel0@gmail.com";
            try {
                await navigator.clipboard.writeText(email);
            } catch (err) {
                const textarea = document.createElement("textarea");
                textarea.value = email;
                textarea.style.position = "fixed";
                textarea.style.opacity = "0";
                document.body.appendChild(textarea);
                textarea.select();
                document.execCommand("copy");
                document.body.removeChild(textarea);
            }
        });
    });
</script>
